# 统一编辑器行为，减少多人协作时的格式差异
# 支持的编辑器：VS Code、WebStorm、Sublime、Notepad++（需装插件）等
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,wxml,wxss,js,ts}]
indent_size = 2

[*.yml]
indent_size = 2
