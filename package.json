{
  "name": "gengyun",
  "version": "0.0.0",
  "private": true,
  "description": "耕云：原生微信小程序 + 独立网页后台 + Fastify 模块化单体 API 的单仓工程壳（GY-I02）。",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11.13.0"
  },
  "workspaces": [
    "services/api",
    "apps/admin"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @gengyun/api",
    "dev:admin": "npm run dev --workspace @gengyun/admin",
    "build": "npm run build --workspace @gengyun/api && npm run build --workspace @gengyun/admin",
    "lint": "node tools/lint-workspaces.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\" \"tests/privacy/*.test.mjs\" \"tests/media/*.test.mjs\" \"tests/reference/*.test.mjs\" \"tests/moderation/*.test.mjs\"",
    "test:contract": "node --test \"tests/contract/*.test.mjs\"",
    "test:reference": "node --test \"tests/reference/*.test.mjs\"",
    "test:evaluation": "node --test \"tests/evaluation/*.test.mjs\"",
    "test:failmatrix": "node tests/failmatrix/run.mjs",
    "test:integration:http": "node tests/integration/knowledge-consumer-http.mjs && node tests/integration/miniprogram-login-loop.mjs && node tests/integration/admin-http.mjs && node tests/integration/profile-ui-http.test.mjs && node tests/integration/recognitions-http.mjs && node tests/integration/jobs-http.mjs && node tests/integration/favorites-history-isolation-http.mjs && node tests/integration/ocr-http.mjs && node tests/integration/account-deletion-http.mjs && node tests/integration/speech-http.mjs && node tests/integration/tts-http.mjs && node tests/integration/tts-content-wiring.mjs && node tests/integration/rejections-http.mjs && node tests/integration/transcript-confirm-http.mjs",
    "test:integration:recognition-chain-pg": "node tests/integration/recognition-chain-e2e.mjs",
    "test:integration:conversations-pg": "node tests/integration/conversations-pg.mjs",
    "test:integration:media-persistence-pg": "node --experimental-strip-types tests/integration/media-persistence-pg.mjs",
    "test:mini": "node tools/check-wechat-project.mjs && node --test tests/local-debug.test.mjs",
    "test:docs": "node tools/run-python.mjs tools/validate_development_docs.py && node tools/verify-research-records.mjs",
    "verify:anchors": "node tools/verify-contract-status.mjs && node tools/verify-doc-anchors.mjs --strict",
    "verify:parity": "node tools/openapi-route-parity.mjs",
    "verify:capability-map": "node tools/verify-admin-capability-map.mjs --check",
    "db:migrate": "npm run db:migrate --workspace @gengyun/api",
    "local:up": "node tools/local-env.mjs up",
    "local:down": "node tools/local-env.mjs down",
    "local:status": "node tools/local-env.mjs status",
    "purge:backup-copies": "node tools/purge-expired-backup-copies.mjs",
    "purge:online-data": "node tools/purge-expired-online-data.mjs",
    "purge:retention": "node tools/purge-retention-expired.mjs",
    "test:integration:backup-copies-purge-pg": "node tests/integration/backup-copies-purge-pg.mjs",
    "test:integration:online-purge-pg": "node tests/integration/online-purge-pg.mjs",
    "test:integration:retention-purge-pg": "node tests/integration/retention-purge-pg.mjs",
    "verify:purge-schedule": "node tools/verify-purge-schedule.mjs",
    "verify:real-capability": "node tools/verify-real-capability-config.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
