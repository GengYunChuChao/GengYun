# 耕云配置模板（GY-I02 工程壳）。本文件不含任何真实密钥，可提交。
# 复制为 .env 并填入本机/服务端安全配置；.env 被 .gitignore 忽略，不要提交。
# 真实模式（APP_EXECUTION_MODE=real）要求下列带「real 必填」标记的项齐备，缺任意项启动即失败并列出字段名。

# ---- 运行时 ----
APP_EXECUTION_MODE=stub          # 必填：real | stub | preset_demo。契约 meta.execution_mode。
API_HOST=127.0.0.1               # 可选，默认 127.0.0.1（不默认绑定 0.0.0.0）
API_PORT=3000                    # 可选，默认 3000，取值 1..65535
LOG_LEVEL=info                   # 可选：fatal|error|warn|info|debug|trace|silent

# ---- 数据库 ----
DATABASE_URL=                    # real 必填：postgresql://user:pass@host:5432/dbname（替身/演示可留空）
DATABASE_HEALTH_TIMEOUT_MS=2000  # 可选，默认 2000，取值 100..60000

# ---- 会话与删除台账密钥（只放服务端）----
SESSION_SIGNING_KEY=             # real 必填：会话签名密钥，至少 32 字符，勿提交；同时用作微信身份摘要（HMAC）与幂等请求摘要（HMAC）的密钥
DELETION_LEDGER_KEY=             # real 必填：独立删除清单密钥，勿提交

# ---- 微信服务端凭据（只放服务端）----
WECHAT_APP_ID=                   # real 必填：正式小程序 AppID（wx4407a4b908a69a54 为公开标识，仍需服务端持有）
WECHAT_APP_SECRET=               # real 必填：AppSecret，勿提交、勿下发客户端
# GY-R68 合成模式固定测试身份（可选，只对 APP_EXECUTION_MODE != real 生效）：
# 填了非空串 ⇒ 合成 subject 由该固定串派生，**该服务端进程的所有 stub 客户端共用一个账号**
# （便于在开发者工具里证「退出 → 用同一身份重登 → 资料/收藏仍在」）；留空/不设 ⇒ 与接线前逐字一致（按 code 派生）。
# ⛔ 不要在多人共用的 stub 服务上开这个开关：所有人共用一个账号，彼此看得到对方的数据（同一账号即同一份资料/收藏）。
# ⛔ 只由服务端环境决定：请求体/查询参数/header 无法影响 subject（那是伪造身份）；real 模式即使填了也不生效。
# 只含空白（含全角空格）＝未设：启动日志的 `wechat_stub_subject_fixed`（生效与否）与
# `wechat_stub_subject_ignored`（设了但只含空白、被忽略）会如实标注，且**只打布尔、不打值**。
WECHAT_STUB_SUBJECT=             # 可选：固定测试身份（最长 128 字符，不含控制字符）；示例 qa-dev-1

# ---- 私有对象存储（只放服务端）----
OBJECT_STORAGE_ENDPOINT=         # real 必填
OBJECT_STORAGE_BUCKET=           # real 必填
OBJECT_STORAGE_ACCESS_KEY=       # real 必填
OBJECT_STORAGE_SECRET_KEY=       # real 必填

# ---- 媒体落库与取图句柄（只放服务端；不参与启动校验，缺了媒体域整域 503）----
# 这两项不在「real 必填」清单里：进程照常起来，但真实媒体/语音链路按域拒绝（见 docs/reference/configuration.md）。
MEDIA_OBJECT_REF_KEY=            # real 且配了 DATABASE_URL 时事实必填：媒体对象引用的加密键材料，用于 AES-256-GCM 加密 media.object_ref_cipher —— 那一列存的是「这条媒体在桶里的对象键」，明文不入库；取值为 64 位十六进制 / 32 字节 base64 / 32 字节原串；缺它 ⇒ 媒体域整域 503 PROVIDER_UNAVAILABLE（retryable:false），7 条媒体路由与语音受理（409 OBJECT_UNAVAILABLE）一起不可用
MEDIA_ACCESS_GRANT_ORIGIN=       # 带启动参数 --approve-real-media-wiring 时必填：AccessGrant.url 的访问网关原点，形如 https://<host>[:port]（不带路径/查询/凭据），网关本身不在本仓；缺它 ⇒ 该参数下启动直接拒绝（exit 1，access_grant_origin_not_deployable），句柄只会指向不可解析的占位域 media.placeholder.invalid

# ---- 独立后台（Vite 公开构建变量，非密钥）----
VITE_API_BASE_URL=/api/v1        # 可选，默认 /api/v1；只用于后台前端指向公开 API 基地址

# ---- 初始管理员（可选；两者要么都不设，要么同时设；口令只以 scrypt 摘要入库）----
# 仅在后台账号表为空时创建一次初始管理员，scope 只含 session:read / session:logout。
ADMIN_BOOTSTRAP_LOGIN_NAME=      # 可选：初始管理员登录名（<=80 字符）
ADMIN_BOOTSTRAP_PASSWORD=        # 可选：初始管理员口令（>=12 字符），勿提交、勿下发客户端

# ---- 参考查询组件关闭开关（GY-I08，关闭型 kill switch）----
APP_GY_I08_DOSE_CARD_ENABLED=true  # 可选，默认 true（未设置/空串即开启）；设为 0/false/off/no 则关闭真实资料用量卡（只出「缺项/未取得」说明，不补造剂量）；无法识别的取值按关闭处理

# ---- AI 真实提供者（TTS / 标签 OCR / 普通话 ASR；GY-R28-W1 接线；全部可选）----
# 只有 APP_EXECUTION_MODE=real **且**该域凭据齐备时，该域才会装上真实适配器；
# 缺任一键 ⇒ 该域仍是接线前的 fail-closed（受理前 503 PROVIDER_UNAVAILABLE），不会回退替身。
# 未配置时与接线前逐字节一致；替身/演示模式即使填了也会被忽略（不携带真实凭据）。
# 端点/地域/音色/编码/采样率/超时/上限一律由服务内冻结常量决定（口径＝tools/ai-config.mjs 的
# AI_ENDPOINTS 与 configurationIssues()），**不需要**也不要在这里配置。
TENCENTCLOUD_SECRET_ID=          # 可选：腾讯云 SecretId（TTS/OCR 共用；ASR 缺专用对时也用它）
TENCENTCLOUD_SECRET_KEY=         # 可选：腾讯云 SecretKey（与上一行同源配对，勿混配）
TENCENTCLOUD_SESSION_TOKEN=      # 可选：临时凭据令牌；长期密钥留空
TENCENTCLOUD_ASR_SECRET_ID=      # 可选：ASR 专用子账号 SecretId（与下一行成对时优先于共享对）
TENCENTCLOUD_ASR_SECRET_KEY=     # 可选：ASR 专用子账号 SecretKey
TENCENTCLOUD_ASR_SESSION_TOKEN=  # 可选：ASR 临时凭据令牌；长期密钥留空

# ---- 识别（拍草）真实提供者（可选；装配处直读 process.env，不走 config.ts 校验）----
# real 模式下两行成对；缺任一 ⇒ POST /api/v1/recognitions 受理前 503 PROVIDER_UNAVAILABLE（retryable:false），不回退替身。
# 即使配齐，本仓当前也没有已审识别适配器：作业仍以 failed / PROVIDER_UNAVAILABLE 收尾，不产生候选。
RECOGNITION_PROVIDER_URL=        # 可选：真实识别供应商端点（与下一行成对）；缺它 ⇒ 识别受理 503 PROVIDER_UNAVAILABLE
RECOGNITION_PROVIDER_KEY=        # 可选：识别供应商 API 密钥，只存内存、勿提交；缺它同样 503（与上一行任一缺失即 fail-closed）

# ---- 问答真实模型（OpenAI 兼容端点；三项要么全配、要么全空）----
# 三项全空 ⇒ 问答照常 200，但走基线确定性回答器（回答版本串带 unimplemented:no-real- 前缀，不是真实模型）。
# 只配一半 ⇒ 启动直接失败并列出字段名（MISSING／INVALID_VALUE），不静默退回确定性回答器。
# 四项全配仍不等于真实调用：还要 DATABASE_URL（外发账本是硬门）且 APP_EXECUTION_MODE=real。
CHAT_LLM_ENDPOINT=               # 可选：https://<host>[:port][/path]（不带查询串/片段/URL 内凭据）；缺它 ⇒ 问答退回确定性摘录
CHAT_LLM_MODEL=                  # 可选：模型名 1..80 字符、无空白/控制字符，只进请求体与回答版本串；缺它 ⇒ 同上
CHAT_LLM_API_KEY=                # 可选：API 密钥 8..200 字符，只存内存、勿提交；缺它（且无下一行的替代）⇒ 同上
DEEPSEEK_API_KEY=                # 可选：CHAT_LLM_API_KEY 的同义替代（二选一；两者都给时用 CHAT_LLM_API_KEY）
CHAT_LLM_TIMEOUT_MS=20000        # 可选，默认 20000，取值 1000..30000；只影响单次外发超时，缺省不影响可用性
CHAT_LLM_MAX_RETRIES=1           # 可选，默认 1，取值 0..2；只重试未派发的失败，缺省不影响可用性
