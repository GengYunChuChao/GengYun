# 统一换行符，避免 Windows / macOS 成员之间产生整文件 diff 噪音
* text=auto eol=lf

*.js    text eol=lf
*.json  text eol=lf
*.wxml  text eol=lf
*.wxss  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf

# 二进制文件不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.mp3   binary
*.mp4   binary
*.zip   binary
*.pdf   binary
*.xlsx  binary
