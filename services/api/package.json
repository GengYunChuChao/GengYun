{
  "name": "@gengyun/api",
  "version": "0.0.0",
  "private": true,
  "description": "耕云 HTTP API 骨架：Fastify 5 模块化单体，含配置校验、/health、契约错误码、迁移运行器。业务路由尚未实现。",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node src/db/migrate.ts up",
    "db:status": "node src/db/migrate.ts status"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
