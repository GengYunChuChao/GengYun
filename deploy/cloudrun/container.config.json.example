{
  "containerPort": 3000,
  "dockerfilePath": "deploy/cloudrun/Dockerfile",
  "buildDir": "",
  "minNum": 1,
  "maxNum": 2,
  "cpu": 0.5,
  "mem": 1,
  "policyType": "cpu",
  "policyThreshold": 80,
  "policyDetails": [
    {
      "PolicyType": "cpu",
      "PolicyThreshold": 80
    },
    {
      "PolicyType": "mem",
      "PolicyThreshold": 80
    }
  ],
  "envParams": {
    "APP_EXECUTION_MODE": "real",
    "API_HOST": "0.0.0.0",
    "API_PORT": "3000",
    "LOG_LEVEL": "info"
  },
  "customLogs": "stdout",
  "initialDelaySeconds": 2
}
