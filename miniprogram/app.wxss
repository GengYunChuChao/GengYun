/**
 * 全局样式基线（GY-I26）
 * ------------------------------------------------------------
 * 指标依据任务书：主题绿 #1F7A45、正文优先 18px、44px 等效触控区。
 * 换算关系：小程序 rpx 以 750 为设计稿宽度，375px 机型下 1px = 2rpx。
 *   正文 18px  -> 36rpx
 *   触控 44px  -> 88rpx
 *
 * 可访问性约定：
 *   1. 任何状态都不只用颜色表达，必须同时有文字或图标；
 *   2. 风险提示不得使用"绝对安全""零风险"等表述；
 *   3. 录音与播放按钮分离，避免误触。
 */

page {
  /* 主题绿 */
  --color-primary: #1F7A45;
  --color-primary-deep: #145C34;
  --color-primary-soft: #E8F3EC;

  /* 背景与文字 */
  --color-bg: #F4F9F4;
  --color-surface: #FFFFFF;
  --color-text: #1B2B1E;
  --color-text-sub: #4A5A4E;
  --color-text-muted: #6F7F72;
  --color-border: #D8E4DC;

  /* 状态色（均配合文字使用） */
  --color-loading: #1F6FB2;
  --color-error: #C62828;
  --color-invalid: #8A6D1F;
  --color-stub: #5B4B8A;

  /* 触控与间距 */
  /* 触控区与字号使用 px 而非 rpx：rpx 为屏宽 750 等分，
     88rpx 仅在 375px 视口等于 44px，320px 窄屏只有约 37.55px，
     36rpx 正文在 320px 视口只有 15.36px，均不满足 44px 触控区与 18px 正文门槛。
     --font-scale 由页面根节点按 wx.getSystemInfoSync().fontSizeSetting 注入，
     实现需求 4.1 的「适配微信字体设置」；缺省 1 表示标准字号。 */
  --font-scale: 1;
  --tap-min: max(44px, 44px * var(--font-scale, 1));
  --gap-xs: 16rpx;
  --gap: 28rpx;
  --gap-lg: 40rpx;
  --radius: 20rpx;
  --radius-lg: 28rpx;

  background: var(--color-bg);
  color: var(--color-text);
  font-size: calc(18px * var(--font-scale, 1));
  line-height: 1.7;
}

/* ============================ 布局 ============================ */

.page {
  min-height: 100vh;
  /* tabBar 为 fixed 覆盖层、不占文档流，页面须自行预留其高度。
     预留值用 px 而非 rpx：tabBar 恒为 50px，而 rpx 随视口缩放，
     100rpx 仅在 375px 视口等于 50px，320/360px 窄屏下会缩到 43/48px 导致末屏被遮挡。
     核算见 tools/verify-layout.mjs。 */
  padding: 32rpx 28rpx calc(54px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page-title {
  font-size: calc(24px * var(--font-scale, 1));
  font-weight: 700;
  line-height: 1.35;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: calc(16px * var(--font-scale, 1));
  color: var(--color-text-sub);
  margin-bottom: 32rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: calc(18px * var(--font-scale, 1));
  font-weight: 600;
  margin: 36rpx 0 20rpx;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  margin-right: 14rpx;
}

/* ============================ 卡片 ============================ */

.card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid var(--color-border);
}

.card-title {
  font-size: calc(18px * var(--font-scale, 1));
  font-weight: 600;
  margin-bottom: 16rpx;
}

.card-text {
  font-size: calc(16px * var(--font-scale, 1));
  color: var(--color-text-sub);
  line-height: 1.7;
}

/* ============================ 按钮 ============================ */

/* 触控高度不小于 44px（px 单位，窄屏 320px 下仍成立；padding 归零且 line-height 1.4，不依赖原生默认高度补足） */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--tap-min);
  padding: 0 16px;
  border-radius: 999rpx;
  font-size: calc(18px * var(--font-scale, 1));
  font-weight: 600;
  line-height: 1.4;
  border: none;
  box-sizing: border-box;
}

.btn--block {
  width: 100%;
}

.btn--primary {
  background: var(--color-primary);
  color: #FFFFFF;
}

.btn--secondary {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.btn--ghost {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.btn[disabled] {
  opacity: 0.5;
}

/* 供各页复用的行内标签 */
.badge {
  display: inline-flex;
  align-items: center;
  /* 随字体放大；上下留 padding，文字换行时容器自然撑高而不溢出圆角 */
  min-height: calc(24px * var(--font-scale, 1));
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  font-size: calc(16px * var(--font-scale, 1));
  font-weight: 600;
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.badge--stub {
  background: #EFEAF7;
  color: var(--color-stub);
}
