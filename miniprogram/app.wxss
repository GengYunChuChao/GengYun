/**
 * 全局样式基线（GY-I26）
 * ------------------------------------------------------------
 * 视觉准绳：docs/ui-demo/（PR #132）—— 设计令牌与组件形态见
 *   styles/tokens.wxss（demo :root 色板，逐值一致）
 *   styles/icons.wxss（demo SVG path 生成的图标层）
 *   styles/components.wxss（demo 的按钮／卡片／pill／底部导航／空态与失败态等形态）
 * 本文件只保留**全局原语**（页面容器、正文、卡片、按钮本体、行内标签），
 * 页面级形态一律走上面的样式层，避免同一类在多个页面各写一套值。
 *
 * 指标依据（任务书）：
 *   正文优先 18px、触控区不小于 44px 等效尺寸、适配微信字体设置、颜色同时配文字／图标。
 *   换算关系：小程序 rpx 以 750 为设计稿宽度，375px 机型下 1px = 2rpx。
 *
 * 可访问性约定：
 *   1. 任何状态都不只用颜色表达，必须同时有文字或图标；
 *   2. 风险提示不得使用「绝对安全」「零风险」等表述；
 *   3. 录音与播放按钮分离，避免误触。
 */

@import "styles/tokens.wxss";
@import "styles/icons.wxss";
@import "styles/components.wxss";

page {
  /* 触控区与字号使用 px 而非 rpx：rpx 为屏宽 750 等分，
     88rpx 仅在 375px 视口等于 44px，320px 窄屏只有约 37.55px，
     36rpx 正文在 320px 视口只有 15.36px，均不满足 44px 触控区与 18px 正文门槛。
     --font-scale 由页面根节点注入，取值由 app.js → utils/system-font.js 计算：
         wx.getFontSizeManager() / wx.getAppBaseInfo() 的 fontSizeScaleFactor 比例字段优先，
         缺失时才用 fontSizeSetting 的 px 值除以 16 换算，封顶 1.3，
         实现需求 4.1 的「适配微信字体设置」；缺省 1 表示标准字号。 */
  --font-scale: 1;
  --tap-min: max(44px, 44px * var(--font-scale, 1));

  background: var(--color-bg);
  color: var(--color-text);
  font-size: calc(18px * var(--font-scale, 1));
  line-height: 1.7;
}

/* ============================ 布局 ============================ */

.page {
  /* --font-scale 定义在本节点，须在本节点计算继承正文，不能依赖父级 page。 */
  font-size: calc(18px * var(--font-scale, 1));
  min-height: 100vh;
  /* tabBar 为 fixed 覆盖层、不占文档流，页面须自行预留其高度。
     预留值取 demo .main 的 padding-bottom 105px（窄屏值），用 px 而非 rpx：
     自定义 tabBar 为图标 21px + 标签 + 上下内距，实测声明合计约 74px，
     放大到 1.3 倍约 88px；105px 覆盖该上限并加底部安全区。
     核算见 tools/verify-layout.mjs（按 custom-tab-bar/index.wxss 的实际声明复算）。 */
  padding: 23px 21px calc(105px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* demo h1：页面主标题。保留 .page-title 供既有页面（GY-I03／I04 等）继续使用。 */
.page-title {
  font-size: calc(24px * var(--font-scale, 1));
  font-weight: 700;
  line-height: 1.4;
}

/* 登录页／识草查药等页把主标题写成 `<view class="title">`，但 `.title` 一直没定义：
   于是这几页的标题落到继承来的 18px 常规字上，和「知识」「识别」等页的 24px 主标题不同级。
   这里把它并到 `.page-title` 同一套字级上（含字段相同的行高与字重），不再各页各写一遍。 */
.title {
  font-size: calc(24px * var(--font-scale, 1));
  font-weight: 700;
  line-height: 1.4;
}

.page-subtitle {
  margin-top: 8px;
  margin-bottom: 20px;
  font-size: calc(16px * var(--font-scale, 1));
  color: var(--color-text-muted);
}

.section-title {
  display: flex;
  align-items: center;
  font-size: calc(18px * var(--font-scale, 1));
  font-weight: 600;
  margin: 25px 0 16px;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: var(--green);
  margin-right: 14rpx;
}

/* ============================ 卡片 ============================ */

/* 对齐 demo .panel{padding:20px;border-radius:14px;border:1px solid var(--line)} */
.card {
  background: var(--color-surface);
  border-radius: var(--radius);
  padding: 20px;
  margin-bottom: 17px;
  border: 1px solid var(--color-border);
  box-sizing: border-box;
}

.card-title {
  font-size: calc(18px * var(--font-scale, 1));
  font-weight: 600;
  margin-bottom: 12px;
}

.card-text {
  font-size: calc(16px * var(--font-scale, 1));
  color: var(--color-text-sub);
  line-height: 1.8;
}

/* ============================ 按钮 ============================ */

/* 触控高度不小于 44px（px 单位，窄屏 320px 下仍成立；padding 取 demo .btn 的 11px 18px，
   字号放大后文字换行时由 padding 自然撑高，min-height 只作下限）。
   配色修饰（.btn--primary／--secondary／--ghost／--lime／--danger）在 styles/components.wxss。 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: var(--tap-min);
  padding: 11px 18px;
  border-radius: 10px;
  font-size: calc(18px * var(--font-scale, 1));
  font-weight: 600;
  line-height: 1.4;
  border: none;
  box-sizing: border-box;
}

/* 微信的基础样式表把 `button` 定成 `width: 184px; margin: 0 auto`，而且注入在**页面同源**的
   样式里、选择器还多带一个伪类（实测特异性高于单个类：`.btn { width: auto }` 会被它按 184px
   压回去，登录页两个按钮就卡在 184px、10 字文案折成「以游客身份浏览首／页」）。
   覆盖时选择器必须同样带元素名 + 一个类（`button.btn`，与它同特异性、靠源序取胜）：
   `width: auto` 让按钮回到父级给的宽度——块级流里撑满一行、flex 行里收到内容宽。
   同理，整宽按钮的 `--block` 也必须写成 `button.btn--block`，否则同样被 184px 压住。 */
button.btn {
  width: auto;
  max-width: 100%;
  /* 同一张基础样式表还写着 `margin: 0 auto`；这里一并收掉，避免按钮在 flex 行里被
     自动外边距推开（块级流里 width:auto 已占满，auto 左右外边距本来就等于 0）。 */
  margin: 0;
}

.btn--block {
  width: 100%;
}

/* 同上：`--block` 也要带元素名，否则被基础样式的 184px 压住（整宽 CTA 会缩成 184px）。 */
button.btn--block {
  width: 100%;
}

.btn[disabled] {
  opacity: 0.5;
}

/* 行内不许断行的片段：用于「记录版本 1」这类短标签，避免长句折行时把数字单独甩到下一行。 */
.nowrap {
  white-space: nowrap;
}

/* 行内强调：WXML 不认 Markdown 的 `**`，原来收藏页把星号原样渲染成了 `**不等于**`。 */
.strong {
  font-weight: 600;
  color: var(--color-text-strong, #17352b);
}

/* 供各页复用的行内标签 */
.badge {
  display: inline-flex;
  align-items: center;
  /* 随字体放大；上下留 padding，文字换行时容器自然撑高而不溢出圆角 */
  min-height: calc(24px * var(--font-scale, 1));
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  font-size: calc(16px * var(--font-scale, 1));
  font-weight: 600;
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.badge--stub {
  background: var(--tone-stub-bg);
  color: var(--color-stub);
}
