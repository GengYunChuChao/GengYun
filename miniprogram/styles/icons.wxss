/**
 * 图标层（GY-I26 demo 对齐）
 * ----------------------------------------------------------------------------
 * 本体由 tools/demo-align.mjs 从 docs/ui-demo/dist/app.js 的 `const paths` 生成，
 * 几何与 demo 逐字一致；不用 <svg> 内联标签，改以 data URI 作为 background-image，
 * 因为 WXSS 不能内联 SVG，而 currentColor 也无法穿透 data URI，故按 demo 的实际
 * 描边色各建一个类（token 取色见 demo styles.css 的对应选择器）。
 *
 * 重新生成：node tools/demo-align.mjs --write-icons
 * 校验一致：node tools/demo-align.mjs
 */

.gy-icon {
  display: inline-block;
  flex-shrink: 0;
  /* 与文字同步随微信字体设置放大，避免大字时图标显得过小 */
  width: calc(var(--gy-icon-size, 21px) * var(--font-scale, 1));
  height: calc(var(--gy-icon-size, 21px) * var(--font-scale, 1));
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

