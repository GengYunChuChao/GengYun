/* Native adaptation of docs/ui-demo/demo.html library/article layout.
   Keep 18px inherited body and 44px controls instead of Demo's preview sizes. */
.knowledge-page { background: #f5f7f4; color: #17352b; }
.breadcrumb, .subtitle, .directory-note { color: #4a5a4e; margin-bottom: 16px; overflow-wrap: anywhere; }
.card { border: 1px solid #e5ebe5; border-radius: 16px; overflow-wrap: anywhere; word-break: break-word; }
.notice { margin: 16px 0; padding: 12px; background: #fff8e1; color: #6d4c00; border-radius: 10px; overflow-wrap: anywhere; }
.status, .result-heading { margin: 16px 0; overflow-wrap: anywhere; }
.result-heading { font-weight: 700; }
.field-label { margin: 12px 0 8px; }
.query-input, .picker { min-height: max(44px, 44px * var(--font-scale, 1)); padding: 8px 12px; box-sizing: border-box; background: #fff; border: 1px solid #dfe8dc; border-radius: 10px; }
.query-input { height: max(52px, 52px * var(--font-scale, 1)); font-size: inherit; }
.chips { display: flex; gap: 8px; flex-wrap: wrap; }
.chips picker { max-width: 100%; }
.chip { border-radius: 22px; color: #315537; overflow-wrap: anywhere; }
.article-art { background: #e6efdf; color: #315534; padding: 16px; margin-bottom: 16px; border-radius: 12px; }
.source-tags { display: flex; flex-wrap: wrap; gap: 8px; }
.pill { background: #eef3e9; color: #315537; border-radius: 6px; padding: 4px 8px; }
.pill.amber { background: #f7f1e3; color: #765b27; }
.source-stat { padding: 12px; background: #fbfcf9; border-radius: 10px; margin: 12px 0; }
.knowledge-body { white-space: pre-wrap; overflow-wrap: anywhere; margin-top: 16px; }
.source-url { overflow-wrap: anywhere; word-break: break-all; }
.detail-heading { display: flex; gap: 12px; align-items: flex-start; }
.detail-heading .page-title { flex: 1; }
.back-button { flex-shrink: 0; min-width: 64px; min-height: max(44px, 44px * var(--font-scale, 1)); font-size: inherit; margin: 0; background: #fff; border: 1px solid #dfe8dc; border-radius: 10px; padding: 8px 12px; }
