/* Follow original Demo library/article tokens and icon paths. At 320px use one
   column to retain 18px text, readable sources and scaled 44px controls. */
.knowledge-page { background: #f5f7f4; color: #17352b; padding-left: 18px; padding-right: 18px; }
.breadcrumb, .subtitle, .directory-note, .card-meta { color: #4a5a4e; margin-bottom: 12px; overflow-wrap: anywhere; }
.knowledge-page .card { background: #fff; padding: 13px; border: 1px solid #e5ebe5; border-radius: 12px; overflow-wrap: anywhere; word-break: break-word; }
.knowledge-page .btn { border-radius: 10px; font-size: inherit; min-height: max(44px, 44px * var(--font-scale, 1)); }
.knowledge-page .btn--primary { background: #176b50; }
.knowledge-page .btn--secondary { background: #eef3e9; color: #176b50; }
.notice { margin: 12px 0; padding: 12px; background: #fff8e1; color: #6d4c00; border-radius: 10px; overflow-wrap: anywhere; }
.status, .result-heading { margin: 16px 0; overflow-wrap: anywhere; }
.result-heading, .section-title { font-weight: 700; }
.section-title { margin-top: 18px; }
.field-label { margin: 12px 0 8px; }
.search-input { position: relative; }
.search-icon { position: absolute; width: 20px; height: 20px; left: 14px; top: calc(26px * var(--font-scale, 1) - 10px); z-index: 1; }
.query-input, .picker { min-height: max(44px, 44px * var(--font-scale, 1)); padding: 8px 12px; box-sizing: border-box; background: #fff; border: 1px solid #dfe7da; border-radius: 10px; }
.query-input { height: max(52px, 52px * var(--font-scale, 1)); font-size: inherit; }
.search-input .query-input { padding-left: 45px; }
.chips { display: flex; gap: 8px; flex-wrap: wrap; }
.chips picker { max-width: 100%; }
.chip { border-radius: 22px; color: #315537; overflow-wrap: anywhere; }
.article-art { position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: center; align-items: center; min-height: 108px; padding: 12px; box-sizing: border-box; background: #e4eddb; color: #315534; margin-bottom: 14px; border-radius: 8px; }
.article-art::before, .article-art::after { content: ''; position: absolute; border: 1px solid rgba(255,255,255,.7); border-radius: 50%; width: 150px; height: 150px; right: -20px; top: 0; }
.article-art::after { width: 100px; height: 100px; right: 15px; top: 25px; }
.leaf-icon { width: 51px; height: 51px; }
.article-art text, .leaf-icon { position: relative; z-index: 1; }
.source-tags { display: flex; flex-wrap: wrap; gap: 8px; }
.pill { background: #eef3e9; color: #315537; border-radius: 20px; padding: 4px 8px; }
.pill.amber { background: #f7f1e3; color: #765b27; }
.stat-grid { display: flex; flex-wrap: wrap; gap: 12px; margin: 12px 0; }
.source-stat { flex: 1; min-width: 100px; border: 1px solid #e5ebe5; padding: 12px; border-radius: 11px; overflow-wrap: anywhere; }
.stat-label { color: #4a5a4e; }
.stat-value { font-weight: 700; }
.knowledge-body { white-space: pre-wrap; overflow-wrap: anywhere; margin-top: 12px; }
.source-url { overflow-wrap: anywhere; word-break: break-all; }
.detail-heading { display: flex; gap: 12px; align-items: flex-start; }
.detail-heading .page-title { flex: 1; min-width: 0; }
.knowledge-page .back-button { flex-shrink: 0; width: auto; min-width: 64px; min-height: max(44px, 44px * var(--font-scale, 1)); font-size: inherit; margin: 0; background: #fff; border: 1px solid #dfe7da; padding: 8px 12px; }
.back-icon { width: 22px; height: 22px; flex-shrink: 0; margin-right: 4px; }
