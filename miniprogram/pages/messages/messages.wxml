<view class="page" style="--font-scale: {{fontScale}}">
  <view class="page-heading">
    <view class="page-heading__main">
      <view class="page-heading__title">消息，让交流继续</view>
      <view class="page-heading__sub">你的互动与探索进度，都在这里。</view>
    </view>
  </view>

  <state-view
    wx:if="{{guest}}"
    status="guest"
    title="请先登录"
    desc="登录后才能收到评论、点赞、审核结果与系统提醒。"
    action-text="去登录"
    bind:action="onLogin"
  ></state-view>

  <block wx:else>
    <view class="section-head">
      <view class="section-head__title">互动通知</view>
      <view class="pill pill--gray">{{unreadNote}}</view>
    </view>

    <!-- demo messages 页的 .section-head：左侧筛选 chips（demo `.chips > .chip`／`.chip.active`
         ⇒ 本仓 `.chips`／`.chip`／`.chip--active`），右侧「全部已读」ghost 按钮。
         筛选档位见 messages.js 顶部 FILTERS：`全部`／`未读` 是派单要求的读写视角，
         `互动`／`系统` 是 demo 原有两档（audit M1），每档都只过滤**已加载的真实消息**。 -->
    <view class="section-head">
      <view class="chips">
        <view
          wx:for="{{filters}}"
          wx:key="value"
          class="chip {{filter === item.value ? 'chip--active' : ''}}"
          data-filter="{{item.value}}"
          bindtap="onFilter"
        >{{item.label}}</view>
      </view>
      <button
        class="btn btn--ghost"
        disabled="{{markingAll || !hasUnread}}"
        bindtap="onMarkAllRead"
      >{{markingAll ? '正在标记…' : '全部已读'}}</button>
    </view>

    <state-view wx:if="{{status === 'loading'}}" status="loading"></state-view>

    <!-- 失败与空态必须可分辨：服务端 real 模式未接线真实消息存储时给「服务未接线」，不写「暂无消息」。 -->
    <state-view
      wx:elif="{{status === 'error'}}"
      status="error"
      title="{{stateTitle}}"
      desc="{{stateDesc}}"
    ></state-view>

    <state-view
      wx:elif="{{status === 'empty'}}"
      status="empty"
      title="暂无消息"
      desc="服务端当前没有你的消息（这是「查到了空列表」，不是「服务未接线」）。审核结果产生后会出现这里。"
    ></state-view>

    <block wx:else>
      <!-- 某一档筛选下没有命中的消息：沿用 state-view 的 empty 口径（不新造状态、
           不伪造数据），并指明这不是「服务端没有消息」。 -->
      <state-view
        wx:if="{{!visibleItems.length}}"
        status="empty"
        title="「{{filterLabel}}」下没有消息"
        desc="当前已加载的消息里没有符合「{{filterLabel}}」的项；切回「全部」可查看已加载的全部通知。"
      ></state-view>

      <view class="message-list" wx:else>
        <view class="message-row" wx:for="{{visibleItems}}" wx:key="id">
          <view class="message-icon"><view class="gy-icon gy-icon--{{item.icon}}"></view></view>
          <view class="message-copy">
            <view class="message-copy__title">{{item.label}}<view wx:if="{{item.unread}}" class="unread-dot"></view></view>
            <view class="message-copy__text">{{item.referenceNote}}</view>
            <view class="message-copy__time">{{item.time}}{{item.unread ? ' · 未读' : ' · 已读'}}</view>
            <view wx:if="{{item.unread}}" class="row-actions">
              <button
                class="btn btn--secondary"
                data-id="{{item.id}}"
                data-revision="{{item.revision}}"
                bindtap="onMarkRead"
                disabled="{{markingId === item.id}}"
              >{{markingId === item.id ? '正在标记…' : '标记已读'}}</button>
            </view>
          </view>
        </view>
      </view>

      <view class="row-actions" wx:if="{{visibleItems.length}}">
        <gy-ui-button
          wx:if="{{nextCursor && filter === 'all'}}"
          label="{{loadingMore ? '正在加载…' : '加载更多'}}"
          variant="ghost"
          loading="{{loadingMore}}"
          bind:tap="onLoadMore"
        ></gy-ui-button>
        <view wx:elif="{{filter !== 'all'}}" class="demo-caption">「{{filterLabel}}」只筛当前已加载的消息；切回「全部」可继续加载。</view>
        <view wx:else class="demo-caption">已经到底了。</view>
      </view>

      <view class="demo-caption" wx:if="{{visibleItems.length}}">{{modeNote}}</view>
    </block>

    <view class="section">
      <view class="section-head">
        <view class="section-head__title">首版消息类型</view>
        <view class="section-head__meta">当前仅「内容审核结果」有生产路径</view>
      </view>
      <view class="panel">
        <view class="info-list">
          <view class="info-row">
            <view class="tiny-art"><view class="gy-icon gy-icon--chat"></view></view>
            <view class="info-row__copy">
              <text class="info-row__title">评论与点赞</text>
              <text class="info-row__desc">别人对你的经验帖或回答的互动</text>
            </view>
          </view>
          <view class="info-row">
            <view class="tiny-art"><view class="gy-icon gy-icon--shield"></view></view>
            <view class="info-row__copy">
              <text class="info-row__title">内容审核结果</text>
              <text class="info-row__desc">投稿通过、需修改或被驳回的原因</text>
            </view>
          </view>
          <view class="info-row">
            <view class="tiny-art"><view class="gy-icon gy-icon--tab-bell"></view></view>
            <view class="info-row__copy">
              <text class="info-row__title">系统通知</text>
              <text class="info-row__desc">资料下架、来源失效等重要变更</text>
            </view>
          </view>
        </view>
      </view>
      <view class="demo-caption">上面的列表只呈现服务端已产生的消息：当前服务端只为「内容审核结果」写入了消息，「评论与点赞」「系统通知」尚无可产生消息的服务端路径（属另一片，本页不假装齐全），本页不展示任何模拟通知。</view>
    </view>
  </block>
</view>
