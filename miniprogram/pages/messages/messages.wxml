<view class="page">
  <view class="page-title">消息</view>
  <view class="page-subtitle">互动通知与审核结果</view>

  <state-view
    wx:if="{{guest}}"
    status="guest"
    title="请先登录"
    desc="登录后才能收到评论、点赞、审核结果与系统提醒。"
  ></state-view>

  <block wx:else>
    <state-view
      status="empty"
      title="暂无消息"
      desc="消息中心尚未接入，不会生成任何模拟通知。后续开放后，真实互动与系统提醒会显示在这里。"
    ></state-view>

    <view class="section-title">首版消息类型</view>
    <view class="card">
      <view class="kind">
        <text class="kind__name">评论与点赞</text>
        <text class="kind__desc">别人对你的经验帖或回答的互动</text>
      </view>
      <view class="kind">
        <text class="kind__name">内容审核结果</text>
        <text class="kind__desc">投稿通过、需修改或被驳回的原因</text>
      </view>
      <view class="kind">
        <text class="kind__name">系统通知</text>
        <text class="kind__desc">资料下架、来源失效等重要变更</text>
      </view>
    </view>
  </block>
</view>
