.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.hero {
  padding: 64rpx 40rpx 56rpx;
  background: linear-gradient(160deg, #43A047 0%, #2E7D32 52%, #1B5E20 100%);
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  box-shadow: 0 16rpx 40rpx rgba(27, 94, 32, 0.22);
}

.hero__brand {
  font-size: 34rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.86);
  letter-spacing: 2rpx;
}

.hero__title {
  margin-top: 20rpx;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #fff;
}

.hero__sub {
  margin-top: 12rpx;
  font-size: 27rpx;
  color: rgba(255, 255, 255, 0.82);
}

.body {
  flex: 1;
  padding: 36rpx 32rpx 48rpx;
}

.card {
  padding: 32rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 10rpx 32rpx rgba(27, 94, 32, 0.08);
}

.card + .card {
  margin-top: 28rpx;
}

.card__title {
  display: flex;
  align-items: center;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.card__title::before {
  content: '';
  width: 10rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #43A047, #2E7D32);
  margin-right: 16rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #EAF3EA;
}

.row:last-child {
  border-bottom: none;
}

.row__dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 20rpx;
}

.row__dot--done {
  background: #43A047;
}

.row__dot--todo {
  background: #F9A825;
}

.row__label {
  flex: 1;
  font-size: 29rpx;
  color: #1B2B1E;
}

.row__value {
  font-size: 26rpx;
  color: #5B6B5E;
}

.tip {
  font-size: 27rpx;
  line-height: 1.8;
  color: #5B6B5E;
}

.footnote {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8A9A8D;
}
