<!-- GY-I13 播报页：安全检查 → 合成 → 播放 三段式。
     文档流顺序刻意是「风险信息与提交按钮在前、播报控件在后」，控件一律走正常文档流
     （本文件与 gy-voice-ball 样式内均无 position:fixed/absolute），因此不会遮挡提交按钮或风险信息。 -->
<view class="page" style="--font-scale: {{fontScale}}">
  <view class="page-heading">
    <view class="page-heading__main">
      <view class="page-heading__title">把已核对的内容念出来</view>
      <view class="page-heading__sub">先过安全检查，再合成，最后才播报；录不进、念不出时如实说明，不假记「已听取」</view>
    </view>
    <view class="page-heading__right"><view class="pill pill--amber">播报</view></view>
  </view>

  <!-- 风险信息（永远在播报控件之前） -->
  <view class="notice notice--warn" wx:if="{{guest}}">
    <text class="notice__icon">🔒</text>
    <text class="notice__text">您正在以游客身份浏览，登录后才能使用播报功能。播报内容不会公开。</text>
  </view>

  <view class="notice notice--danger">
    <text class="notice__icon">⚠️</text>
    <text class="notice__text">播报只是把「已通过核对」的正文念出来，不构成任何用药建议；
      用量与配比一律以核验资料为准，本页不提供剂量换算。</text>
  </view>

  <view class="notice notice--stub" wx:if="{{substituteNote}}">
    <text class="notice__icon">🧪</text>
    <text class="notice__text">{{substituteNote}}</text>
  </view>

  <view class="notice" wx:if="{{exitNote}}">
    <text class="notice__icon">🚪</text>
    <text class="notice__text">离开本页（返回／切页／隐藏）：{{exitNote}}</text>
  </view>

  <!-- ① 安全检查 -->
  <view class="section">
    <view class="section-head">
      <view class="section-head__title">① 安全检查（在前）</view>
      <view class="section-head__meta">{{checkState || '未选择内容'}}</view>
    </view>
    <view class="panel">
      <view class="hint" wx:if="{{samples.length === 0}}">
        本地替身样本仅在本地替身工程可见（当前不可见）。本页不发明内容来源：没有可核对的正文时不会合成，也不会播报。
      </view>
      <view class="row-actions" wx:if="{{samples.length > 0}}">
        <button
          wx:for="{{samples}}"
          wx:key="id"
          class="btn {{selectedSampleId === item.id ? 'btn--primary' : 'btn--secondary'}} row-actions__item"
          aria-role="button"
          aria-label="{{item.label}}"
          data-id="{{item.id}}"
          bindtap="onSelectSample"
        >{{item.label}}</button>
      </view>

      <view class="hint" wx:if="{{checkState}}">check_state：{{checkState}}</view>
      <view class="notice {{checkPassed ? '' : 'notice--danger'}}" wx:if="{{checkMessage}}">
        <text class="notice__text">{{checkMessage}}</text>
      </view>
      <view class="demo-caption" wx:if="{{checkedText}}">已核对正文（{{segmentCount}} 段）：{{checkedText}}</view>
      <view class="hint" wx:if="{{segmentPreview}}">{{segmentPreview}}</view>

      <!-- 提交（合成）入口：位于播报控件**之前**，不会被控件遮挡。 -->
      <view class="row-actions">
        <button
          class="btn btn--primary row-actions__item voice-submit"
          aria-role="button"
          aria-label="安全检查通过后提交合成"
          disabled="{{guest || busy || !checkPassed}}"
          bindtap="onBroadcast"
        >{{busy ? '正在提交…' : '通过检查后合成'}}</button>
      </view>
      <view class="hint">安全检查未通过时，提交按钮保持禁用，且不会发起任何合成请求。</view>
    </view>
  </view>

  <!-- ② 合成状态（七类逐类呈现，不折叠） -->
  <view class="section" wx:if="{{stage === 'synthesis' || job || synthesisNote}}">
    <view class="section-head">
      <view class="section-head__title">② 合成任务</view>
      <view class="pill pill--blue">{{mode || '未取得执行模式'}}</view>
    </view>
    <view class="panel">
      <view class="hint" wx:if="{{job}}">JobState：{{job.state}} · {{job.label}}</view>
      <view class="hint" wx:if="{{job && job.errorCode}}">error_code：{{job.errorCode}}</view>
      <view class="hint" wx:if="{{job}}">任务 {{job.id}} · revision {{job.revision}} · 产物 media_id：{{job.mediaId || '（本次没有产物）'}}</view>
      <view class="notice notice--danger" wx:if="{{synthesisNote}}">
        <text class="notice__text">{{synthesisNote}}</text>
      </view>
      <view class="hint">失败与超时都如实显示 error_code；不会把失败折叠成「播放成功」。</view>
    </view>
  </view>

  <!-- ③ 播报控件：语音球 + 等效按钮（在提交按钮与风险信息之后，正常文档流） -->
  <view class="section">
    <view class="section-head">
      <view class="section-head__title">③ 播报控件</view>
      <view class="pill pill--gray">语音球 · 播放/暂停/停止/重播</view>
    </view>
    <view class="panel">
      <!-- 来源如实：契约里没有面向客户端的音频出口 ⇒ 取不到可播放来源时**显式**写明，
           绝不显示「播放中／已播放」，也不用别的音频顶替（口径见 utils/voice-api.js）。 -->
      <view class="notice notice--danger" wx:if="{{sourceNotice}}">
        <text class="notice__icon">🔇</text>
        <text class="notice__text">{{sourceNotice}}</text>
      </view>

      <view class="notice notice--stub" wx:if="{{localEnabled && substituteWalkthrough}}">
        <text class="notice__icon">🧪</text>
        <text class="notice__text">替身播放已开启（本地替身工程显式开启）：非真实音频，不产生任何声音、不朗读任何内容，
          只走控件与事件生命周期；替身播放不计入「已听取」，也不代表已取得可播放来源。</text>
      </view>

      <!-- 自动播报开关（用户可关）：关闭后**不自动出声**，文字与「播放」按钮照常可用；
           「同一页同一版本只自动播报一次」「读不到偏好则不自动」的原因都写在下面的说明里。 -->
      <view class="row-actions">
        <button
          class="btn btn--secondary row-actions__item"
          aria-role="button"
          aria-label="切换自动播报"
          bindtap="onToggleAutoSpeak"
        >{{autoSpeakEnabled ? '关闭自动播报' : '开启自动播报'}}</button>
      </view>
      <view class="hint" wx:if="{{autoSpeakNote}}">{{autoSpeakNote}}</view>

      <gy-voice-ball
        state="{{playbackState}}"
        listened="{{listened}}"
        disabled="{{guest}}"
        label="{{ballLabel}}"
        hint="{{ballHint}}"
        failure-title="{{failure ? failure.title : ''}}"
        failure-hint="{{failure ? failure.hint : ''}}"
        failure-action="{{failure ? failure.actionText : ''}}"
        bind:play="onPlay"
        bind:pause="onPause"
        bind:stop="onStop"
        bind:replay="onReplay"
      ></gy-voice-ball>

      <view class="hint" wx:if="{{substitute && substituteCompleted}}">替身播放已走完：非真实音频，未记「已听取」。</view>
      <view class="hint" wx:if="{{listened}}">已听取：整份播报已自然播完。</view>
      <view class="hint" wx:if="{{!listened && playbackState !== 'idle'}}">当前未记「已听取」（只有整份播报自然播完才算）。</view>

      <!-- 本地替身工程走查开关（默认关闭替身播放；开关只影响本地替身工程） -->
      <view class="row-actions" wx:if="{{localEnabled}}">
        <button
          class="btn btn--secondary row-actions__item"
          aria-role="button"
          aria-label="切换替身播放走查"
          bindtap="onToggleWalkthrough"
        >{{substituteWalkthrough ? '关闭替身播放走查' : '开启替身播放走查'}}</button>
      </view>
      <view class="row-actions" wx:if="{{localEnabled}}">
        <button
          wx:for="{{['AUTOPLAY_BLOCKED', 'MUTED', 'BLUETOOTH', 'PERMISSION_DENIED']}}"
          wx:key="*this"
          class="btn btn--secondary row-actions__item"
          aria-role="button"
          aria-label="模拟失败分支 {{item}}"
          data-code="{{item}}"
          bindtap="onPickFailureProbe"
        >模拟 {{item}}</button>
        <button
          class="btn btn--ghost row-actions__item"
          aria-role="button"
          aria-label="清除模拟失败分支"
          data-code=""
          bindtap="onPickFailureProbe"
        >清除模拟失败</button>
      </view>
      <view class="hint" wx:if="{{probing}}">已选择模拟失败分支：{{failureProbe}}（下一次播放按该分支报错，文案与主动播放按钮随之变化）。</view>
    </view>
  </view>

  <!-- 录音控件：与播报控件**分离**的独立控件。真调用原生录音能力，各态逐态可分辨、如实呈现。 -->
  <view class="section">
    <view class="section-head">
      <view class="section-head__title">录音（独立控件）</view>
      <view class="section-head__meta">{{recordState === 'recording' ? '录音中' : (recordState === 'uploading' ? '上传中' : (recordState === 'stopped' ? '已录音' : (recordState === 'failed' ? '未成功' : '未录音')))}}</view>
    </view>
    <view class="panel">
      <view class="hint">{{recordNote}}</view>
      <view class="hint">{{voiceLimitNote}}</view>
      <view class="hint" wx:if="{{recordSupportNote}}">能力自述：{{recordSupportNote}}</view>
      <view class="notice notice--warn" wx:if="{{!recordSupported}}">
        <text class="notice__icon">🎙️</text>
        <text class="notice__text">当前环境不提供录音能力：本页不会采集、不会上传，也不假装在录。</text>
      </view>

      <!-- 各态可分辨：录音中显示已录时长与上限；上传中/失败/完成各自一句，互不混淆 -->
      <view class="hint" wx:if="{{recordState === 'recording'}}">
        已录 {{recordElapsedMs}} ms / 上限 {{recordMaxMs}} ms（契约 UploadInput.duration_ms.maximum）。停止后按真实时长上传。
      </view>
      <view class="hint" wx:if="{{recordDurationMs > 0}}">
        本次录音：{{recordDurationMs}} ms · {{recordedMime || '（未取得编码）'}}
      </view>
      <view class="notice {{recordState === 'failed' ? 'notice--danger' : (recordState === 'stopped' ? 'notice--stub' : '')}}" wx:if="{{recordStageNote}}">
        <text class="notice__text">{{recordStageNote}}</text>
      </view>
      <view class="hint" wx:if="{{uploadErrorCode}}">错误码：{{uploadErrorCode}}（未收录的码一律如实带出，不折叠成"失败"）</view>
      <view class="hint" wx:if="{{uploadedMediaId}}">已上传 media_id：{{uploadedMediaId}} · 用途：{{uploadedPurpose}}</view>
      <view class="hint" wx:if="{{recordState === 'stopped' && !uploadedMediaId}}">录音已在本机完成，但没有成功上传：本页不伪造 media_id，也不显示"已发送／已回答"一类结论。</view>

      <view class="row-actions">
        <button
          class="btn {{recordState === 'recording' ? 'btn--primary' : 'btn--secondary'}} row-actions__item voice-record"
          aria-role="button"
          aria-label="{{recordLabel}}"
          disabled="{{guest || recordState === 'uploading'}}"
          bindtap="onRecord"
        >{{recordLabel}}</button>
      </view>

      <view class="notice" wx:if="{{recordState === 'failed'}}">
        <text class="notice__icon">🎙️</text>
        <text class="notice__text">{{recordPermissionNote}}</text>
      </view>

      <view class="demo-caption">录音控件与上方播报控件是两个独立控件：录音不会触发播报，播报也不采集任何音频。</view>
      <view class="demo-caption">录音按用途 voice_question 上传（真实模式）；转写、核对与发送见下方「转写核对」区，未经明确确认不会发送任何问答。</view>
    </view>
  </view>

  <!-- ④ 转写核对（GY-I11 客户端切片，stub/preset_demo 局部实现）：
       受理 → 轮询记录 → 可编辑正文 → 用户明确确认 → 才发送语音轮次。
       取消／失败／迟到回调一律不外发；确认与发送都带幂等键。真实 ASR 未接线前，
       替身文本明确标注，不构成任何识别效果或准确率证据。 -->
  <view class="section">
    <view class="section-head">
      <view class="section-head__title">④ 转写核对（可编辑 · 确认后发送）</view>
      <view class="section-head__meta">{{transcriptStage === '' ? '未开始' : transcriptStage}}</view>
    </view>
    <view class="panel">
      <view class="hint">链路：受理转写 → 等待记录 → 核对并编辑正文 → 明确确认后发送到问答。
        未经确认不外发；已取消、失败终态、迟到响应都不会外发。</view>

      <view class="notice notice--stub" wx:if="{{transcriptSampleNote}}">
        <text class="notice__icon">🧪</text>
        <text class="notice__text">{{transcriptSampleNote}}</text>
      </view>

      <view class="row-actions" wx:if="{{transcriptSamples.length > 0}}">
        <button
          wx:for="{{transcriptSamples}}"
          wx:key="id"
          class="btn {{selectedTranscriptSampleId === item.id ? 'btn--primary' : 'btn--secondary'}} row-actions__item"
          aria-role="button"
          aria-label="{{item.label}}"
          data-id="{{item.id}}"
          bindtap="onPickTranscriptSample"
        >{{item.label}}</button>
      </view>

      <view class="hint" wx:if="{{uploadedMediaId !== '' && uploadedMediaRevision >= 1}}">
        当前录音引用：真实上传 media_id {{uploadedMediaId}}（revision {{uploadedMediaRevision}}，用途 voice_question）
      </view>
      <view class="hint" wx:elif="{{transcriptMediaLabel}}">当前录音引用：{{transcriptMediaLabel}}</view>

      <view class="row-actions">
        <button
          class="btn btn--secondary row-actions__item voice-submit"
          aria-role="button"
          aria-label="受理本条录音的转写"
          disabled="{{guest || transcriptBusy || (uploadedMediaId === '' && selectedTranscriptSampleId === '')}}"
          bindtap="onRequestTranscript"
        >{{transcriptStage === 'requesting' ? '正在受理…' : '转写本条录音'}}</button>
      </view>

      <view class="hint" wx:if="{{transcriptId}}">
        转写 {{transcriptId}} · revision {{transcriptRevision}} · model_version {{transcriptModel || '（未取得）'}}
      </view>
      <view class="hint" wx:if="{{transcriptSpans.length > 0}}">
        不确定区间 {{transcriptSpans.length}} 处（服务端如实上报，本页不删改）：
      </view>
      <view class="hint" wx:for="{{transcriptSpans}}" wx:key="reason">
        [{{item.start}}, {{item.end}}] {{item.reason}}
      </view>

      <!-- 可编辑正文：确认发送前一律可改；草稿不写已确认快照 -->
      <textarea
        class="input textarea"
        value="{{transcriptDraft}}"
        maxlength="{{8000}}"
        placeholder="转写正文将显示在这里，可编辑后确认发送"
        disabled="{{guest || transcriptBusy || transcriptStage !== 'ready'}}"
        bindinput="onTranscriptInput"
      ></textarea>

      <view class="row-actions">
        <button
          class="btn btn--primary row-actions__item voice-submit"
          aria-role="button"
          aria-label="核对并发送：确认后才会把该正文作为语音轮次发送"
          disabled="{{guest || transcriptBusy || transcriptStage !== 'ready'}}"
          bindtap="onConfirmAndSend"
        >{{transcriptStage === 'confirming' ? '正在确认…' : (transcriptStage === 'sending' ? '正在发送…' : '核对并发送')}}</button>
        <button
          class="btn btn--ghost row-actions__item voice-submit"
          aria-role="button"
          aria-label="取消本次转写：取消后不会发送任何问答"
          disabled="{{guest || transcriptStage === '' || transcriptStage === 'confirming' || transcriptStage === 'sending' || transcriptStage === 'cancelling' || transcriptStage === 'cancelled' || transcriptStage === 'sent'}}"
          bindtap="onCancelTranscript"
        >{{transcriptStage === 'cancelling' ? '正在取消…' : '取消（不发送）'}}</button>
      </view>

      <view class="notice notice--danger" wx:if="{{transcriptNote}}">
        <text class="notice__text">{{transcriptNote}}</text>
      </view>
      <view class="hint" wx:if="{{transcriptErrorCode}}">错误码：{{transcriptErrorCode}}（未收录的码一律如实带出，不折叠成"失败"）</view>
      <view class="hint" wx:if="{{sendJobId}}">回答任务 {{sendJobId}} · state {{sendJobState}}（回答内容不在本页呈现）</view>
      <view class="demo-caption">确认与发送都带幂等键：同一尝试的重试不会重复确认或重复发送；双击被在途守卫挡下。</view>
    </view>
  </view>
</view>
