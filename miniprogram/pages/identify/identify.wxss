/* 识别页（GY-I26 demo 对齐）
 * ---------------------------------------------------------------------------
 * 通用形态已落到 styles/components.wxss：page-heading / notice / section-head /
 * feature-grid / feature-card / row-actions / message-list / pill / hint / demo-caption。
 * 本文件只保留识别页专属的状态块与候选行，并统一改用 tokens.wxss 的 demo 令牌。
 *
 * 未改写 GY-I09 已交付的三入口交互（仍为「一个入口一个按钮 + data-mode」），
 * demo 的 .scan-stage / .scan-frame / .process-panel 形态已落入样式层，
 * 可在样式走查页 pages/specimen/specimen 逐项核对。
 */

/* 七类 JobState 的状态块：底色区分，同时显示契约状态名，不只靠颜色 */
.state-chip {
  display: flex;
  flex-direction: column;
  padding: 16px;
  margin-bottom: 17px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--line);
  background: #FFFFFF;
}

.state-chip--pending { background: #f2f7f3; border-color: #cfe0d4; }
.state-chip--success { background: #eaf6ee; border-color: #b9dec5; }
.state-chip--warning { background: var(--tone-warn-bg); border-color: #e8d6ad; }
.state-chip--error { background: var(--tone-danger-bg); border-color: #eec6c0; }
.state-chip--muted { background: #f2f4f2; border-color: #d5dbd6; }

.state-chip__code {
  font-size: calc(14px * var(--font-scale, 1));
  color: var(--muted);
}

.state-chip__title {
  margin-top: 8rpx;
  font-size: calc(18px * var(--font-scale, 1));
  font-weight: 600;
}

.state-chip__desc {
  margin-top: 8rpx;
  font-size: calc(16px * var(--font-scale, 1));
  line-height: 1.7;
  color: var(--color-text-sub);
}

.state-chip__err {
  margin-top: 8rpx;
  font-size: calc(14px * var(--font-scale, 1));
  color: var(--muted);
}

/* 不确定原因：沿用 demo 的 notice 语气，内部只排标题与条目 */
.reasons {
  display: block;
  margin-bottom: 17px;
}

.reasons__body {
  flex: 1;
  min-width: 0;
}

.reasons__title {
  font-size: calc(16px * var(--font-scale, 1));
  font-weight: 600;
  margin-bottom: 10rpx;
}

.reasons__item {
  display: block;
  font-size: calc(16px * var(--font-scale, 1));
  line-height: 1.8;
  color: inherit;
}

/* 候选行：结构对应 demo .result-candidate（图标 + 名称 + 分数） */
.candidate {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: max(44px, 44px * var(--font-scale, 1));
  padding: 16px;
  margin-bottom: 11px;
  border-radius: var(--radius-sm);
  background: #FFFFFF;
  border: 1px solid var(--line);
  box-sizing: border-box;
}

/* 选中态取 demo .period.active{border-color:#76995d;background:#f0f5e9} */
.candidate--picked {
  border-color: #76995d;
  background: #f0f5e9;
}

.candidate__rank {
  flex: 0 0 auto;
  width: 60rpx;
  font-size: calc(16px * var(--font-scale, 1));
  font-weight: 600;
  color: var(--green);
}

.candidate__body { flex: 1; min-width: 0; }

.candidate__name {
  font-size: calc(18px * var(--font-scale, 1));
  font-weight: 600;
}

.candidate__score {
  margin-top: 6rpx;
  font-size: calc(16px * var(--font-scale, 1));
  color: var(--color-text-sub);
}

.candidate__state {
  flex: 0 0 auto;
  font-size: calc(14px * var(--font-scale, 1));
  color: var(--green);
}

/* 关联科普条目：沿用 demo .panel 的观感 */
.knowledge {
  padding: 16px;
  margin-top: 11px;
  border-radius: var(--radius-sm);
  background: #FFFFFF;
  border: 1px solid var(--line);
}

.knowledge__name {
  font-size: calc(18px * var(--font-scale, 1));
  font-weight: 600;
}

.knowledge__meta {
  margin-top: 6rpx;
  font-size: calc(16px * var(--font-scale, 1));
  color: var(--color-text-sub);
  line-height: 1.7;
}
