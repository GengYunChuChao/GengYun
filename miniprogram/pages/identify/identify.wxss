/* 识别页（GY-I26 demo 对齐）
 * ---------------------------------------------------------------------------
 * 通用形态已落到 styles/components.wxss：page-heading / notice / section-head /
 * feature-grid / feature-card / row-actions / message-list / pill / hint / demo-caption。
 * 本文件只保留识别页专属的状态块与候选行，并统一改用 tokens.wxss 的 demo 令牌。
 *
 * 未改写 GY-I09 已交付的三入口交互（仍为「一个入口一个按钮 + data-mode」），
 * demo 的 .scan-stage / .scan-frame / .process-panel 形态已落入样式层，
 * 可在样式走查页 pages/specimen/specimen 逐项核对。
 */

/* 七类 JobState 的状态块：底色区分，同时显示契约状态名，不只靠颜色 */
.state-chip {
  display: flex;
  flex-direction: column;
  padding: 16px;
  margin-bottom: 17px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--line);
  background: #FFFFFF;
}

.state-chip--pending { background: #f2f7f3; border-color: #cfe0d4; }
.state-chip--success { background: #eaf6ee; border-color: #b9dec5; }
.state-chip--warning { background: var(--tone-warn-bg); border-color: #e8d6ad; }
.state-chip--error { background: var(--tone-danger-bg); border-color: #eec6c0; }
.state-chip--muted { background: #f2f4f2; border-color: #d5dbd6; }

.state-chip__code {
  font-size: calc(14px * var(--font-scale, 1));
  color: var(--muted);
}

.state-chip__title {
  margin-top: 8rpx;
  font-size: calc(18px * var(--font-scale, 1));
  font-weight: 600;
}

.state-chip__desc {
  margin-top: 8rpx;
  font-size: calc(16px * var(--font-scale, 1));
  line-height: 1.7;
  color: var(--color-text-sub);
}

.state-chip__err {
  margin-top: 8rpx;
  font-size: calc(14px * var(--font-scale, 1));
  color: var(--muted);
}

/* 不确定原因：沿用 demo 的 notice 语气，内部只排标题与条目 */
.reasons {
  display: block;
  margin-bottom: 17px;
}

.reasons__body {
  flex: 1;
  min-width: 0;
}

.reasons__title {
  font-size: calc(16px * var(--font-scale, 1));
  font-weight: 600;
  margin-bottom: 10rpx;
}

.reasons__item {
  display: block;
  font-size: calc(16px * var(--font-scale, 1));
  line-height: 1.8;
  color: inherit;
}

/* 候选行：结构对应 demo .result-candidate（图标 + 名称 + 分数） */
.candidate {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: max(44px, 44px * var(--font-scale, 1));
  padding: 16px;
  margin-bottom: 11px;
  border-radius: var(--radius-sm);
  background: #FFFFFF;
  border: 1px solid var(--line);
  box-sizing: border-box;
}

/* 选中态取 demo .period.active{border-color:#76995d;background:#f0f5e9} */
.candidate--picked {
  border-color: #76995d;
  background: #f0f5e9;
}

.candidate__rank {
  flex: 0 0 auto;
  width: 60rpx;
  font-size: calc(16px * var(--font-scale, 1));
  font-weight: 600;
  color: var(--green);
}

.candidate__body { flex: 1; min-width: 0; }

.candidate__name {
  font-size: calc(18px * var(--font-scale, 1));
  font-weight: 600;
}

.candidate__score {
  margin-top: 6rpx;
  font-size: calc(16px * var(--font-scale, 1));
  color: var(--color-text-sub);
}

.candidate__state {
  flex: 0 0 auto;
  font-size: calc(14px * var(--font-scale, 1));
  color: var(--green);
}

/* 关联科普条目：沿用 demo .panel 的观感 */
.knowledge {
  padding: 16px;
  margin-top: 11px;
  border-radius: var(--radius-sm);
  background: #FFFFFF;
  border: 1px solid var(--line);
}

.knowledge__name {
  font-size: calc(18px * var(--font-scale, 1));
  font-weight: 600;
}

.knowledge__meta {
  margin-top: 6rpx;
  font-size: calc(16px * var(--font-scale, 1));
  color: var(--color-text-sub);
  line-height: 1.7;
}

/* 六类失败/边界分支：归类 + 落点 + 重试语义（沿用 demo 卡片观感） */
.branch {
  margin-top: 14rpx;
  padding: 16px;
  border-radius: var(--radius-sm);
  background: #FFFFFF;
  border: 1px solid var(--line);
}

.branch__head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.branch__pill {
  align-self: flex-start;
}

.branch__label {
  font-size: calc(18px * var(--font-scale, 1));
  font-weight: 600;
  line-height: 1.6;
}

.branch__meta {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 18rpx;
}

.branch__meta-item {
  font-size: calc(15px * var(--font-scale, 1));
  color: var(--color-text-sub);
}

/* 用量守卫：恒不可展示 + 条件不完整时的阻断说明 */
.dose-guard {
  margin-top: 11px;
  padding: 16px;
  border-radius: var(--radius-sm);
  background: #FFF8E6;
  border: 1px solid #F0D9A0;
}

.dose-guard__row {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.dose-guard__row + .dose-guard__row {
  margin-top: 10rpx;
}

.dose-guard__tag {
  font-size: calc(16px * var(--font-scale, 1));
  font-weight: 600;
  color: #8A5A00;
}

.dose-guard__tag--warn {
  color: #A33A1A;
}

.dose-guard__reason,
.dose-guard__note {
  font-size: calc(15px * var(--font-scale, 1));
  color: var(--color-text-sub);
  line-height: 1.7;
}

/* ------------------------------------------------- 人工校正（#10 AC①） */

/* 被人工改过的字段整行加左侧标记条，与未改过的行一眼可辨（不隐藏机器读数）。 */
.knowledge--changed {
  border-left: 6rpx solid #C46A1A;
  background: #FFF6EC;
}

.corr-diff__flag {
  font-size: calc(13px * var(--font-scale, 1));
  color: #A33A1A;
  line-height: 1.6;
}

.corr {
  margin-top: 16rpx;
  padding: 16rpx;
  border: 1px solid #E3D9C8;
  border-radius: 12rpx;
  background: #FFFDF8;
}

.corr__title {
  font-size: calc(16px * var(--font-scale, 1));
  font-weight: 600;
}

.corr__meta {
  margin-top: 6rpx;
  font-size: calc(13px * var(--font-scale, 1));
  color: var(--color-text-sub);
  line-height: 1.6;
}

/* 冲突重读 / 提交成功 / 校验失败 / 用量阻断：四种反馈各有独立底色，避免混成一句。 */
.corr__conflict,
.corr__success,
.corr__error,
.corr__blocked {
  margin-top: 12rpx;
  padding: 10rpx 12rpx;
  border-radius: 8rpx;
  font-size: calc(14px * var(--font-scale, 1));
  line-height: 1.7;
}

.corr__conflict {
  background: #FFF3E0;
  border: 1px solid #E8C48A;
  color: #8A5A00;
}

.corr__success {
  background: #EDF7EE;
  border: 1px solid #B9DDBD;
  color: #2F6B38;
}

.corr__error {
  background: #FDEDEA;
  border: 1px solid #F0C0B4;
  color: #A33A1A;
}

.corr__blocked {
  background: #FDF3F3;
  border: 1px solid #E9B7B7;
  color: #8C2F2F;
}

.corr__row,
.corr__ing {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.corr__ing {
  padding-top: 12rpx;
  border-top: 1px dashed #E3D9C8;
}

.corr__label {
  font-size: calc(15px * var(--font-scale, 1));
  font-weight: 600;
}

/* 不复用 maxlength：输入框只承载原文，超长由 `buildCorrectionInput` 在提交前拒绝并给出实际长度。 */
.corr__input {
  width: 100%;
  box-sizing: border-box;
  min-height: calc(40px * var(--font-scale, 1));
}

.corr__count {
  font-size: calc(12px * var(--font-scale, 1));
  color: var(--color-text-sub);
}

.corr__sub {
  margin-top: 18rpx;
  font-size: calc(14px * var(--font-scale, 1));
  color: var(--color-text-sub);
  line-height: 1.7;
}

.corr__remove {
  align-self: flex-start;
  font-size: calc(13px * var(--font-scale, 1));
  color: #A33A1A;
}

.corr__confirm {
  margin-top: 18rpx;
  padding: 12rpx;
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  border: 1px solid #D8CDB8;
  border-radius: 10rpx;
  background: #FFFFFF;
}

.corr__confirm--on {
  border-color: #4E7A3A;
  background: #F2F8EE;
}

.corr__check {
  font-size: calc(16px * var(--font-scale, 1));
  line-height: 1.4;
}

.corr__confirm-text {
  flex: 1;
  font-size: calc(14px * var(--font-scale, 1));
  line-height: 1.6;
}
