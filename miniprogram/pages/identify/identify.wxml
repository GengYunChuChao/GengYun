<view class="page" style="--font-scale: {{fontScale}}">
  <view class="page-heading">
    <view class="page-heading__main">
      <view class="page-heading__title">每一次发现，都值得看清</view>
      <view class="page-heading__sub">拍照片识别田里的杂草，得到至多 3 个候选，再自行核对</view>
    </view>
  </view>

  <view class="notice notice--warn" wx:if="{{guest}}">
    <text class="notice__icon">🔒</text>
    <text class="notice__text">您正在以游客身份浏览，登录后才能实际使用识别功能。识别结果不会公开。</text>
  </view>

  <view class="notice" wx:if="{{modeNote}}">
    <text class="notice__icon">🧪</text>
    <text class="notice__text">{{modeNote}}</text>
  </view>

  <view class="notice notice--stub" wx:if="{{substituteNotice}}">
    <text class="notice__icon">🔁</text>
    <text class="notice__text">{{substituteNotice}}</text>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-head__title">识别入口</view>
      <view class="section-head__meta">三个入口</view>
    </view>
    <view class="feature-grid">
      <button
        wx:for="{{modes}}"
        wx:key="key"
        class="feature-card"
        hover-class="feature-card--hover"
        disabled="{{guest || busy}}"
        data-mode="{{item.key}}"
        bindtap="onShoot"
      >
        <view class="feature-card__icon"><view class="gy-icon {{item.iconClass}}"></view></view>
        <view class="feature-card__title">{{item.title}}</view>
        <view class="feature-card__desc">{{item.desc}}</view>
        <view class="pill pill--gray feature-card__action">{{item.action}}</view>
      </button>
    </view>
  </view>

  <!-- 任务状态：七类各自一句，不合并成「失败」；门禁未通过（guest）一律不展示私有数据 -->
  <view class="section" wx:if="{{stateView && !guest}}">
    <view class="section-head">
      <view class="section-head__title">任务状态</view>
      <view class="pill pill--blue">JobState</view>
    </view>
    <view class="state-chip state-chip--{{stateView.tone}}">
      <text class="state-chip__code">JobState：{{stateView.state}}</text>
      <text class="state-chip__title">{{stateView.title}}</text>
      <text class="state-chip__desc">{{stateView.desc}}</text>
      <text class="state-chip__err" wx:if="{{stateView.state === 'failed' || stateView.state === 'timed_out'}}">服务端错误码以接口返回为准（error_code 非 null 时才显示）。</text>
    </view>

    <!-- 六类失败/边界分支：逐类给出如实归类与**唯一**重试动作（不可重试时不给入口） -->
    <view class="branch" wx:if="{{branchInfo}}">
      <view class="branch__head">
        <text class="pill pill--amber branch__pill">边界分支：{{branchInfo.branch}}</text>
        <text class="branch__label">{{branchInfo.label}}</text>
      </view>
      <view class="branch__meta">
        <text class="branch__meta-item" wx:if="{{branchInfo.jobState}}">落到状态：{{branchInfo.jobState}}</text>
        <text class="branch__meta-item" wx:if="{{branchInfo.errorCode}}">错误码：{{branchInfo.errorCode}}</text>
        <text class="branch__meta-item" wx:if="{{!branchInfo.createsJob}}">该分支在受理前拦截，不会产生识别记录</text>
      </view>
      <view class="hint">可重试：{{branchInfo.retryable ? '是' : '否'}}<text wx:if="{{branchInfo.retryable}}">（动作：{{branchInfo.retryLabel}}）</text></view>
    </view>

    <view class="row-actions">
      <button class="btn btn--secondary row-actions__item" wx:if="{{!stateView.terminal}}" bindtap="onCancelJob">取消任务</button>
      <button class="btn btn--secondary row-actions__item" wx:if="{{branchInfo && branchInfo.retryable}}" bindtap="onRetry">{{branchInfo.retryLabel || '重试'}}</button>
      <button class="btn btn--secondary row-actions__item" wx:if="{{!branchInfo && stateView.retryable}}" bindtap="onRetry">重新识别</button>
    </view>
  </view>

  <!--
    标签 OCR（#10）：与识草共用同一套私有媒体上传与既有 OCR 路由；
    任务状态取契约 Job（GET /jobs/{id}）七类逐类呈现；标签正文取 GET /ocr/{id}：机器原样读数（raw_fields）
    与当前生效字段（corrected_fields）**同时**呈现、差异逐项标记；人工核对后的更正只写 corrected_fields
    （PATCH /ocr/{id}/correction，恰好一次请求，冲突则重读后再确认而非静默重试）。
    硬口径：**机器读数、非权威判读**；**永不渲染用量正文或任何剂量数字**（只报条数）。
  -->
  <view class="section" wx:if="{{ocr && !guest}}">
    <view class="section-head">
      <view class="section-head__title">标签识别（OCR）</view>
      <view class="pill pill--blue">JobState：{{ocr.state}}</view>
    </view>
    <view class="state-chip state-chip--{{ocr.tone}}">
      <text class="state-chip__code">JobState：{{ocr.state}}</text>
      <text class="state-chip__title">{{ocr.stateTitle}}</text>
      <text class="state-chip__desc">{{ocr.stateDesc}}</text>
      <text class="state-chip__err" wx:if="{{ocr.errorCode}}">服务端错误码：{{ocr.errorCode}}</text>
    </view>
    <view class="row-actions" wx:if="{{!ocr.terminal}}">
      <button class="btn btn--secondary row-actions__item" bindtap="onCancelOcrJob">取消本次标签识别</button>
    </view>
    <view class="hint" wx:if="{{ocr.cancelNote}}">{{ocr.cancelNote}}</view>

    <block wx:if="{{ocr.record}}">
      <view class="pill pill--amber">机器读数 · 非权威判读 · 不提供用量</view>
      <view class="hint">{{ocr.record.authorityNote}}</view>
      <view class="hint" wx:if="{{!ocr.success}}">该任务未成功完成（JobState：{{ocr.record.jobState}}）：以下标签文本不可作为结论，请人工核对或重拍。</view>
      <!-- 原样文本（raw_fields 逐字段照录；缺项写「（未读出）」，不改写、不做任何换算） -->
      <view class="knowledge" wx:for="{{ocr.record.readRows}}" wx:key="label">
        <view class="knowledge__name">{{item.label}}：{{item.value}}</view>
      </view>
      <!-- 来源 / 状态标签 -->
      <view class="knowledge__meta">来源版本：{{ocr.record.sourceVersion}} · 记录版本：{{ocr.record.revision}} · 执行模式：{{ocr.record.mode}}</view>
      <view class="knowledge__meta">登记核对：{{ocr.record.matchLabel}}（是否命中登记：{{ocr.record.hasRegistration ? '是' : '否'}}）</view>
      <view class="reasons__item" wx:for="{{ocr.record.missingFields}}" wx:key="*this">· 缺项字段：{{item}}</view>
      <view class="reasons__item" wx:for="{{ocr.record.conflictLabels}}" wx:key="*this">· 与登记冲突：{{item}}</view>
      <!--
        当前生效字段（corrected_fields）：与上面机器读数**逐项并排**，被人工改过的整行标记并回显机器读数，
        未改过的行注明「与机器读数一致」——不隐藏任何一格，也不把更正后的值冒充机器读数。
      -->
      <view class="knowledge__meta" wx:if="{{ocr.record.correctedDiffers}}">以下为当前生效字段（corrected_fields，含已提交的人工更正）：</view>
      <view class="knowledge__meta" wx:else>当前生效字段（corrected_fields）与机器读数一致，尚无人工更正。</view>
      <view class="{{item.changed ? 'knowledge knowledge--changed' : 'knowledge'}}" wx:for="{{ocr.record.diffRows}}" wx:key="label">
        <view class="knowledge__name">{{item.label}}：{{item.corrected}}</view>
        <view class="corr-diff__flag" wx:if="{{item.changed}}">人工已更正；机器原样读数为「{{item.raw}}」</view>
      </view>
      <!-- 用药安全：只报用量卡条数，绝不渲染正文与任何剂量数字 -->
      <view class="dose-guard">
        <view class="dose-guard__row">
          <text class="dose-guard__tag">用量：不可展示</text>
          <text class="dose-guard__reason">{{ocr.record.doseNote}}登记用量卡 {{ocr.record.doseCardCount}} 条，本页不渲染正文与任何剂量数字。</text>
        </view>
      </view>
      <view class="hint">{{ocr.record.readOnlyNote}}</view>
      <view class="hint">{{ocr.record.correctionNote}}</view>
      <!-- 人工校正入口：任务未成功（或被取消）时不给入口，避免"看起来能改"的错觉 -->
      <view class="row-actions" wx:if="{{ocr.record.canCorrect && !labelCorrection}}">
        <button class="btn btn--secondary row-actions__item" bindtap="onStartCorrection">对照包装核对并更正字段</button>
      </view>
      <!--
        校正面板：输入框**不设 maxlength**（不裁剪用户输入），超长一律在提交前被校验拒绝并提示实际长度；
        未勾选「已对照包装核对」时提交不会发出任何请求。
      -->
      <view class="corr" wx:if="{{labelCorrection}}">
        <view class="corr__title">人工核对与更正（只写 corrected_fields）</view>
        <view class="corr__meta">基准记录版本：{{labelCorrection.revision}}（提交时按 If-Match 逐字带上该版本；服务端版本已变则本次更正不会被接受）</view>
        <view class="corr__conflict" wx:if="{{labelCorrection.conflictText}}">{{labelCorrection.conflictText}}</view>
        <view class="corr__success" wx:if="{{labelCorrection.successText}}">{{labelCorrection.successText}}</view>
        <view class="corr__error" wx:if="{{labelCorrection.errorText}}">{{labelCorrection.errorText}}</view>
        <view class="corr__blocked" wx:if="{{labelCorrection.blockedNote}}">{{labelCorrection.blockedNote}}</view>

        <view class="corr__row" wx:for="{{labelCorrection.fields}}" wx:key="key">
          <view class="corr__label">{{item.label}}</view>
          <input class="input corr__input" value="{{item.value}}" data-index="{{index}}" bindinput="onCorrectionFieldInput" placeholder="未读出可留空（留空按未读出提交，不补造内容）" />
          <view class="corr__count">{{item.value.length}} / {{item.maxLength}} 字（超长会被拒绝，不会被截断）</view>
        </view>

        <view class="corr__sub">有效成分（最多 20 条；整行留空的行提交时被丢弃，半空行会被拒绝）</view>
        <view class="corr__ing" wx:for="{{labelCorrection.ingredients}}" wx:key="key">
          <view class="corr__label">第 {{index + 1}} 条</view>
          <input class="input corr__input" value="{{item.name}}" data-index="{{index}}" data-part="name" bindinput="onCorrectionIngredientInput" placeholder="成分名称" />
          <input class="input corr__input" value="{{item.content_text}}" data-index="{{index}}" data-part="content_text" bindinput="onCorrectionIngredientInput" placeholder="含量（照录包装上的数字）" />
          <input class="input corr__input" value="{{item.unit_text}}" data-index="{{index}}" data-part="unit_text" bindinput="onCorrectionIngredientInput" placeholder="单位（如 %、克/升）" />
          <button class="text-btn corr__remove" data-index="{{index}}" bindtap="onCorrectionRemoveIngredient">删除这一条</button>
        </view>
        <view class="row-actions">
          <button class="btn btn--secondary row-actions__item" bindtap="onCorrectionAddIngredient">增加一条有效成分</button>
        </view>

        <!-- 显式核对：ambiguous/conflict（含同名不同制剂）与冲突重读后都要求重新勾选，不静默匹配 -->
        <view class="corr__confirm {{labelCorrection.confirmed ? 'corr__confirm--on' : ''}}" bindtap="onCorrectionToggleConfirm">
          <text class="corr__check">{{labelCorrection.confirmed ? '☑' : '☐'}}</text>
          <text class="corr__confirm-text">我已对照农药包装实物逐项核对（同名不同制剂或多条可能匹配时，本页不替你挑一条）</text>
        </view>
        <view class="row-actions">
          <button class="btn btn--secondary row-actions__item" bindtap="onCorrectionSubmit">{{labelCorrection.submitting ? '提交中…' : '提交更正'}}</button>
          <button class="btn btn--secondary row-actions__item" bindtap="onCorrectionCancel">取消并保留现有内容</button>
        </view>
      </view>
    </block>

    <view class="notice notice--warn" wx:if="{{ocr.recordNote}}">{{ocr.recordNote}}</view>
    <view class="row-actions" wx:if="{{ocr.terminal}}">
      <button class="btn btn--secondary row-actions__item" bindtap="onOcrRetry">重新拍摄标签</button>
    </view>
  </view>

  <!-- 不确定原因：如实列出，不隐藏、不改写成成功 -->
  <view class="notice notice--warn reasons" wx:if="{{uncertaintyReasons.length && !guest}}">
    <view class="reasons__body">
      <view class="reasons__title">不确定原因（服务端 uncertainty_reasons）</view>
      <view class="reasons__item" wx:for="{{uncertaintyReasons}}" wx:key="*this">· {{item}}</view>
    </view>
  </view>

  <!-- 候选：succeeded 才算识别成功；uncertain 必须人工核对；历史记录不推断任务状态 -->
  <view class="section" wx:if="{{showTop3 && !guest}}">
    <view class="section-head">
      <view class="section-head__title">{{candidateSource === 'history' ? '历史记录候选（模型原始结果）' : (candidatesTrusted ? '候选（识别成功）' : '候选（不可信，需人工核对）')}}</view>
      <view class="pill" wx:if="{{!candidatesTrusted}}">需人工核对</view>
    </view>
    <view class="hint" wx:if="{{historyNote}}">{{historyNote}}</view>
    <view class="candidate {{pendingManualId === item.species_id ? 'candidate--picked' : ''}}" wx:for="{{candidates}}" wx:key="species_id" data-id="{{item.species_id}}" bindtap="onTapCandidate">
      <view class="candidate__rank">#{{item.rank}}</view>
      <view class="candidate__body">
        <view class="candidate__name">{{item.species_id}}</view>
        <view class="candidate__score">模型分数：{{item.scoreText}}</view>
      </view>
      <view class="candidate__state" wx:if="{{selectedSpeciesId === item.species_id}}">已选择</view>
    </view>
    <view class="hint" wx:if="{{!candidatesTrusted && candidateSource !== 'history'}}">这是「不确定」结果：请人工核对后再确认，确认前不会记录选择、也不会查询关联科普。</view>
    <view class="row-actions" wx:if="{{pendingManualId}}">
      <button class="btn btn--primary row-actions__item" bindtap="onConfirmManual">确认人工核对结果</button>
      <button class="btn btn--secondary row-actions__item" bindtap="onCancelManual">取消</button>
    </view>
  </view>

  <!-- 收藏入口（GY-I16）：自包含组件，只吃 jobId；候选 / 目标资料版本 / 已收藏状态由组件自己取 -->
  <fav-entry job-id="{{job.id}}" enabled="{{!guest}}" />

  <!-- 关联科普查询（选择之后）；用量恒被 GY-I08 守卫阻断，条件不完整即阻断并列出缺项 -->
  <view class="section" wx:if="{{relatedKnowledge && !guest}}">
    <view class="section-head">
      <view class="section-head__title">关联科普（{{relatedKnowledge.matchStateLabel}}）</view>
      <view class="pill pill--gray">{{relatedKnowledge.ruleVersion}}</view>
    </view>
    <view class="pill pill--amber">资料为种子整理稿 · 待核实 · 非权威 · 不提供用量</view>
    <!-- 查询口径如实标注：本地资料没有「杂草对象」的结构化标注，本条命中来自名称文本匹配 -->
    <view class="hint">{{relatedKnowledge.matchNote}}</view>

    <!-- 用量守卫：识别/选择这条路径恒不可给用量（不是"恰好没数据"），且条件不完整时明确阻断 -->
    <view class="dose-guard">
      <view class="dose-guard__row">
        <text class="dose-guard__tag">用量：不可展示</text>
        <text class="dose-guard__reason">阻断类别 {{relatedKnowledge.dose.blockCode}}（识别/选择路径恒不给用量，需走资料详情按 GY-I08 规则核对）</text>
      </view>
      <view class="dose-guard__row" wx:if="{{relatedKnowledge.conditionsComplete}}">
        <text class="dose-guard__note">条件已完整；即便如此，本路径仍不提供用量。</text>
      </view>
      <view class="dose-guard__row" wx:else>
        <text class="dose-guard__tag dose-guard__tag--warn">条件不完整，已阻断用量查询</text>
        <text class="dose-guard__reason">缺少：{{relatedKnowledge.missingConditionLabels}}</text>
      </view>
    </view>

    <!-- 逐条可点进详情：id 形状与 pages/referencedetail 的校验一致（[A-Za-z0-9_-]{1,128}） -->
    <view
      class="knowledge"
      wx:for="{{relatedKnowledge.items}}"
      wx:key="recordId"
      data-id="{{item.recordId}}"
      bindtap="onOpenKnowledgeDetail"
    >
      <view class="knowledge__name">{{item.name}}</view>
      <view class="knowledge__meta">登记证号：{{item.registrationNumber}} · 剂型：{{item.dosageForm}}</view>
      <view class="knowledge__meta">使用场景：{{item.useScene}}</view>
      <!-- 来源/审核标签如实带出（本地资料层的 labels，原文照录） -->
      <view class="knowledge__meta">来源标签：{{item.labels.source_kind}} · {{item.labels.evidence_kind}} · 审核：{{item.labels.review_status}} · 记录：{{item.labels.record_status}}</view>
      <!-- 逐条用量归因与页面顶部同一口径：本路径恒不给用量（不再引用"功能开关已关闭"） -->
      <view class="knowledge__meta">用量：不可展示（{{item.doseReason}}；阻断类别 {{item.doseBlockCode}}，规则版本 {{item.doseRuleVersion}}）</view>
      <view class="knowledge__meta">查看资料详情 ›</view>
    </view>
    <view class="reasons__item" wx:for="{{relatedKnowledge.reasons}}" wx:key="*this">· {{item}}</view>
    <view class="demo-caption">{{relatedKnowledge.note}}</view>
    <view class="row-actions">
      <button class="btn btn--secondary row-actions__item" wx:if="{{recordId}}" bindtap="onDeleteRecord">删除这条识别记录</button>
    </view>
  </view>

  <view class="notice notice--danger" wx:if="{{errorText}}">{{errorText}}</view>

  <!-- GY-I26（#28）「已删除」必须可见：删除成功后结果区整块复位，缺这一句就与「点了没反应」无异。 -->
  <view class="notice" wx:if="{{deleteNote}}">
    <text class="notice__icon">✅</text>
    <text class="notice__text">{{deleteNote}}</text>
  </view>

  <!-- 私有历史：必须绑定「当前已核实主体」（historyOwner），不能只凭本机索引长度 -->
  <view class="section" wx:if="{{!guest && historyOwner && history.length}}">
    <view class="section-head">
      <view class="section-head__title">我的识别记录（私有）</view>
      <view class="pill pill--gray">{{history.length}} 条</view>
    </view>
    <!-- 如实说明：本机索引为什么只在本次打开期间有效（不持久化、不跨启动），以及跨启动该看哪里 -->
    <view class="hint">本机索引仅在本次打开期间有效（不写入本机存储，重启即清空）；跨启动请看「我的 → 识别历史」。</view>
    <view class="message-list">
      <view class="message-row" wx:for="{{history}}" wx:key="recordId" data-id="{{item.recordId}}" bindtap="onOpenHistoryItem">
        <view class="message-copy">
          <text class="message-copy__title">{{item.stateTitle}}</text>
          <text class="message-copy__time">{{item.state}} · {{item.at}}</text>
        </view>
      </view>
    </view>
    <view class="row-actions">
      <button class="btn btn--secondary row-actions__item" bindtap="onClearHistory">清空本机索引</button>
      <button class="btn btn--secondary row-actions__item" bindtap="onOpenServerHistory" role="button" aria-label="识别历史">我的 → 识别历史</button>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-head__title">其他入口</view>
      <view class="section-head__meta">语音提问</view>
    </view>
    <view class="panel">
      <view class="hint">录音与播放尚未接入真实服务；此处仅演示按钮布局，不会采集录音、不会上传。</view>
      <view class="row-actions">
        <button class="btn btn--primary row-actions__item" disabled="{{guest}}" bindtap="onRecord">
          {{recording ? '录音中…' : '开始录音'}}
        </button>
        <button class="btn btn--secondary row-actions__item" disabled="{{guest || !hasRecording}}" bindtap="onPlay">
          播放录音
        </button>
      </view>
      <view class="demo-caption" wx:if="{{!hasRecording}}">还没有录音。录音与播放能力尚未接入，本页不会采集或上传任何音频。</view>
    </view>
  </view>

  <!-- 失败 / 空态 / 处理中一律收口到统一 state-view 组件（本页不自己拼一套状态样式）。
       error-code：六类分支里的 permission_denied 即契约 CONSENT_REQUIRED（403），
       由统一状态层判定为「没有权限」语气（不是通用失败）；该分支的动作文案是「重试」，
       属于针对性动作，故 allow-denied-action 打开，其余 403 场景仍收起重试按钮。
       措辞红线：**不写「去授权」**——应用内授权入口尚未接入（契约缺用途政策读取面），
       照那样写就是把用户指向不存在的功能；按钮实际只重试本次操作，见
       `utils/identify-api.js` 的 RETRY_ACTION_LABELS 与 `docs/verification/gy-i04-login-chain-20261021.md`。 -->
  <state-view
    wx:if="{{stateView && !guest && stateView.component !== 'ready'}}"
    status="{{stateView.component}}"
    error-code="{{branch === 'permission_denied' ? 'CONSENT_REQUIRED' : ''}}"
    title="{{branchInfo ? branchInfo.label : stateView.title}}"
    desc="{{stateView.desc}}"
    actionText="{{branchInfo && branchInfo.retryable ? branchInfo.retryLabel : ''}}"
    allow-denied-action="{{branch === 'permission_denied'}}"
    busy="{{busy}}"
    bind:action="onRetry"
  ></state-view>
</view>
