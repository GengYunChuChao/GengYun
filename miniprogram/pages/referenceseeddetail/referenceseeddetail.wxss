/* GY-I07 种子资料详情页样式。 */
.banner { background: #FFF8E1; border-left: 8rpx solid #F9A825; border-radius: 12rpx; padding: 20rpx 24rpx; margin: 16rpx 0; color: #6D4C00; line-height: 1.6; font-size: calc(16px * var(--font-scale, 1)); }
.banner-tag { display: inline-block; background: #F9A825; color: #fff; border-radius: 8rpx; padding: 4rpx 14rpx; font-size: calc(16px * var(--font-scale, 1)); margin-bottom: 10rpx; }
.banner-line { margin-top: 6rpx; }

.section-title { font-size: calc(16px * var(--font-scale, 1)); font-weight: bold; color: #1B5E20; margin-bottom: 16rpx; }
.row { display: flex; align-items: flex-start; line-height: 1.7; margin: 10rpx 0; }
.k { width: 210rpx; color: #52665a; flex-shrink: 0; }
.v { flex: 1; color: #25352a; }
.v-block { color: #25352a; line-height: 1.75; }
.note { color: #6D4C00; background: #FFF8E1; border-radius: 10rpx; padding: 16rpx 20rpx; margin-top: 14rpx; font-size: calc(16px * var(--font-scale, 1)); line-height: 1.7; }

.item-head { display: flex; justify-content: space-between; align-items: baseline; }
.item-name { font-size: calc(18px * var(--font-scale, 1)); font-weight: bold; }
.tag { border-radius: 8rpx; padding: 4rpx 12rpx; font-size: calc(16px * var(--font-scale, 1)); }
.tag-warn { background: #FFF3E0; color: #E65100; }

.btn-ghost { background: #E8F1E8; color: #2E7D32; }
.disclaimer { color: #78909C; font-size: calc(16px * var(--font-scale, 1)); margin-top: 24rpx; line-height: 1.7; }
