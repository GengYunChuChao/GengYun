/* 「我的」页（GY-I26 demo 对齐）
 * ---------------------------------------------------------------------------
 * 页面形态走 styles/components.wxss 的 demo 组件层（profile-header／stat-grid／
 * profile-grid／panel／setting-row／notice／row-actions／pill／demo-caption）。
 * 本文件只保留编辑表单需要的一处排版。
 */

.profile-form__locate {
  margin: 11px 0;
}

/* IP 属地说明：demo 展示「上海 · 演示」样例值；本版不读取 IP，如实标注 */
.ip-location__note {
  font-size: calc(14px * var(--font-scale, 1));
  opacity: 0.75;
  margin-left: 6rpx;
}

/* picker 触发区的兼容类：形态走 demo .setting-row；同时保留 .selection，
   因为既有 tests/integration/local-dev-profile-ui.cjs 以 .selection 测量字号
   （受控最大字号档期望 23.4px），保留稳定选择器比改他人验证脚本更稳。
   这里只补触控下限与盒模型，不覆盖 .setting-row 的 flex 排版。 */
.selection {
  min-height: var(--tap-min, 44px);
  box-sizing: border-box;
}
