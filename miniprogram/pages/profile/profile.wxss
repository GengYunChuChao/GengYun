.guest-card {
  padding: 32rpx 28rpx;
  border-radius: var(--radius-lg, 28rpx);
  background: var(--color-surface, #fff);
  border: 2rpx solid var(--color-border, #D8E4DC);
}

.guest-card__title {
  font-size: calc(19px * var(--font-scale, 1));
  font-weight: 700;
}

.guest-card__desc {
  margin-top: 14rpx;
  font-size: calc(16px * var(--font-scale, 1));
  line-height: 1.7;
  color: var(--color-text-sub, #4A5A4E);
}

.guest-card__btn {
  width: 100%;
  margin-top: 28rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--color-bg, #F4F9F4);
}

.row:last-child {
  border-bottom: none;
}

.row__label {
  flex: 0 0 220rpx;
  font-size: calc(16px * var(--font-scale, 1));
  color: var(--color-text-sub, #4A5A4E);
}

.row__value {
  flex: 1;
  font-size: calc(16px * var(--font-scale, 1));
  font-weight: 600;
  color: var(--color-text, #1B2B1E);
}
/* 字号选择：三个按钮均为适老触控区，选中态不只靠颜色区分 */
.font-choices {
  display: flex;
  gap: 16rpx;
}

.font-choice {
  flex: 1;
  min-height: var(--tap-min);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 8rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius);
  background: #FFFFFF;
  box-sizing: border-box;
}

.font-choice--on {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.font-choice__label {
  font-size: calc(18px * var(--font-scale, 1));
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.3;
}

.font-choice--on .font-choice__label {
  color: var(--color-primary-deep);
}

/* 选中标记同时用文字与颜色表达，不单独依赖颜色 */
.font-choice__mark {
  font-size: calc(13px * var(--font-scale, 1));
  color: var(--color-primary-deep);
  margin-top: 4rpx;
}
