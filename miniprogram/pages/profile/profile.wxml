<view class="page" style="--font-scale: {{fontScale}}">
  <view class="page-heading">
    <view class="page-heading__main">
      <view class="page-heading__title">我的耕云</view>
      <view class="page-heading__sub">把探索与发现，整理成自己的田间档案。</view>
    </view>
  </view>

  <!-- demo .profile-header：头像 + 身份 + 操作区 -->
  <view class="profile-header">
    <view class="profile-header__avatar">{{guest ? '游' : '我'}}</view>
    <view class="profile-header__main">
      <view class="profile-header__title">{{guest ? '游客' : '我的档案'}}</view>
      <view class="profile-header__desc">{{guest ? '尚未登录 · 登录不要求手机号' : cropName + ' · ' + regionName}}</view>
    </view>
    <view class="profile-actions">
      <button wx:if="{{guest}}" class="btn btn--primary" bindtap="onLogin">前往微信登录</button>
      <view class="ip-location">IP 属地：未接入<text class="ip-location__note">（本版不读取 IP）</text></view>
    </view>
  </view>

  <view class="stat-grid">
    <view class="stat" bindtap="openFavorites" role="button" aria-label="我的收藏">
      <text class="stat__value">{{favoriteCount}}</text>
      <text class="stat__label">我的收藏</text>
    </view>
    <view class="stat" bindtap="openHistory" role="button" aria-label="识别历史">
      <text class="stat__value">{{historyCount}}</text>
      <text class="stat__label">识别历史</text>
    </view>
    <!-- demo .stat-grid 的三项都是可点的 <button class="stat">：我的发布 → 社区页「我的投稿」。
         小程序没有独立的「我的发布」页，故跳既有路由并按契约 `mine` 预选筛选（不新建页面）。 -->
    <view class="stat" bindtap="openMyPosts" role="button" aria-label="我的发布（在社区页按我的投稿查看）">
      <text class="stat__value">{{myPostCount}}</text>
      <text class="stat__label">我的发布</text>
    </view>
  </view>

  <view class="demo-caption">「我的发布」显示社区「我的投稿」第一页的已加载条数（带 + 表示还有下一页；服务端封套不提供总数），点开即到社区页并预选「我的投稿」。</view>

  <view class="notice notice--warn" wx:if="{{guest}}">
    <text class="notice__icon">🔒</text>
    <text class="notice__text">登录后才能保存我的作物与地区、收藏资料和识别记录。账号登录沿用已接入的独立登录页，收藏与识别历史已接入独立页面；登录不要求手机号。</text>
  </view>

  <block wx:else>
    <view class="profile-grid">
      <view class="panel">
        <view class="panel-head">
          <view class="panel-head__title">我的档案</view>
          <view class="pill pill--gray">单项作物 · 浙江市县</view>
        </view>
        <!-- 读取中/读取失败时本面板**不**留“待读取”的静默占位：加载态与失败态都有可见反馈，
             失败态还带重试入口（GY-I05）。统一走 state-view，不另写一行灰字当失败提示
             （docs/ui-state-inventory.md:80）。 -->
        <state-view
          wx:if="{{busy && !loaded}}"
          status="loading"
          title="正在读取档案与目录"
        ></state-view>
        <state-view
          wx:elif="{{loadError}}"
          status="error"
          error-code="{{loadErrorCode}}"
          title="档案暂时读取失败"
          desc="{{loadError}}"
          action-text="重试读取档案"
          bind:action="loadProfile"
        ></state-view>
        <view class="info-list" wx:else>
          <view class="info-row">
            <view class="info-row__copy">
              <text class="info-row__title">所在地区</text>
              <text class="info-row__desc">{{regionName}}</text>
            </view>
          </view>
          <view class="info-row">
            <view class="info-row__copy">
              <text class="info-row__title">种植作物</text>
              <text class="info-row__desc">{{cropName}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="panel profile-form">
        <view class="panel-head">
          <view class="panel-head__title">编辑档案</view>
          <view class="pill pill--gray">{{editing ? '编辑中' : '未编辑'}}</view>
        </view>
        <view class="hint" role="status">{{message}}</view>

        <view class="row-actions">
          <!-- 入口保持可点：读取失败/目录为空时由 onEdit 给出可见原因，不靠 disabled 静默吞掉点击（GY-I05）。 -->
          <button class="btn btn--secondary row-actions__item" bindtap="loadProfile" disabled="{{busy}}">重新读取档案</button>
          <button wx:if="{{!editing}}" class="btn btn--primary row-actions__item" bindtap="onEdit" disabled="{{busy}}">手选作物与市县</button>
        </view>

        <block wx:if="{{editing}}">
          <button class="btn btn--secondary btn--block profile-form__locate" bindtap="onLocate" disabled="{{busy || locating || retryPending || needsReload}}">
            {{locating ? '正在定位…' : '使用定位选地区（可改手选）'}}
          </button>
          <picker range="{{crops}}" range-key="name" value="{{cropIndex < 0 ? 0 : cropIndex}}" bindchange="onCrop" disabled="{{busy || retryPending || needsReload}}">
            <!-- .selection 是既有 tests/integration/local-dev-profile-ui.cjs 测量字号用的稳定选择器，
                 与 demo .setting-row 形态并存，不改他人验证脚本 -->
            <view class="setting-row selection">
              <text class="setting-row__label">种植作物</text>
              <text class="setting-row__value">{{cropIndex < 0 ? '请选择' : crops[cropIndex].name}}</text>
              <view class="gy-icon gy-icon--arrow"></view>
            </view>
          </picker>
          <picker range="{{cities}}" range-key="name" value="{{cityIndex < 0 ? 0 : cityIndex}}" bindchange="onCity" disabled="{{busy || retryPending || needsReload}}">
            <view class="setting-row selection">
              <text class="setting-row__label">浙江市</text>
              <text class="setting-row__value">{{cityIndex < 0 ? '请选择' : cities[cityIndex].name}}</text>
              <view class="gy-icon gy-icon--arrow"></view>
            </view>
          </picker>
          <picker range="{{counties}}" range-key="name" value="{{countyIndex < 0 ? 0 : countyIndex}}" bindchange="onCounty" disabled="{{busy || retryPending || needsReload || !counties.length}}">
            <view class="setting-row selection">
              <text class="setting-row__label">县区</text>
              <text class="setting-row__value">{{countyIndex < 0 ? '未选县区，使用所选市' : counties[countyIndex].name}}</text>
              <view class="gy-icon gy-icon--arrow"></view>
            </view>
          </picker>
          <view class="row-actions">
            <button class="btn btn--secondary row-actions__item" bindtap="useCity" disabled="{{busy || retryPending || needsReload}}">仅使用所选市</button>
            <button class="btn btn--primary row-actions__item" bindtap="onSave" disabled="{{busy || needsReload}}">{{busy ? '处理中…' : retryPending ? '重试同一次保存' : '确认并保存档案'}}</button>
            <button class="btn btn--secondary row-actions__item" bindtap="onCancel" disabled="{{busy || retryPending}}">取消编辑</button>
          </view>
        </block>

        <view class="demo-caption">仅保存一项作物和浙江市县，手选不需要定位授权。定位只用于即时选择地区，不保存原始坐标；定位被拒绝、取消、超时、省外或地区转换不可用时都可继续手选。</view>
      </view>
    </view>

    <view class="row-actions">
      <button class="btn btn--secondary row-actions__item" bindtap="openReference" disabled="{{busy}}">按当前档案查科普资料</button>
      <button class="btn btn--secondary row-actions__item" bindtap="logout">退出登录</button>
    </view>
  </block>

  <!-- demo profile 的「关于这次体验」面板：静态说明，无数据源、无交互歧义。
       措辞按小程序端**实测事实**写：demo 那句「登录、授权和资料保存均为本地模拟」是网页原型的
       自述，小程序端登录走微信登录、档案走服务端，照抄即为假，故只保留可核对的部分
       （见 docs/verification/gy-i28-demo-parity-20261018.md 的逐条对照）。 -->
  <view class="section">
    <view class="section-head">
      <view class="section-head__title">关于这次体验</view>
    </view>
    <view class="panel">
      <view class="setting-row">
        <text class="setting-row__label">耕云 Demo</text>
        <text class="setting-row__value">Demo 阶段</text>
      </view>
      <view class="card-text">耕云 · 看见田间的可能</view>
      <view class="card-text">覆盖五个主入口与核心探索流程，与网页版 demo 同一套视觉与交互口径。</view>
      <view class="demo-caption">登录、档案、收藏与识别历史均走微信登录与后端服务读取（非本地模拟）；本页不展示任何本地伪造数据。版本号无构建来源，故不显示具体版本。</view>
    </view>
  </view>

  <!-- 隐私说明：**只写实现得到的事**。改前这里写「拍摄照片、录音和位置信息都需要您单独授权，
       且可以随时撤回」，但应用内既没有授权入口也没有撤回入口（`POST/DELETE /me/consents` 需要
       `policy_version`/`recipient_ids`，契约没有读取面）——那是把不存在的功能写成承诺。
       见 docs/verification/gy-i04-login-chain-20261021.md 的「口径决定」第 6 条。 -->
  <view class="section">
    <view class="section-head">
      <view class="section-head__title">隐私说明</view>
    </view>
    <view class="panel">
      <view class="card-text">
        平台不会默认保存原始照片的拍摄位置，也不会把您的资料用于模型训练。
        拍摄照片、录音和位置信息都需要您单独授权；未获得授权时不会上传或外发，也不会用替身结果顶替。
      </view>
      <view class="card-text">
        应用内的授权与撤回入口尚未接入，因此本页暂不提供授权开关；在入口接入前不会默认替您授权。
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-head__title">当前状态</view>
    </view>
    <state-view
      status="{{guest ? 'guest' : 'stub'}}"
      title="{{guest ? '请先登录' : '收藏与识别历史在独立页面'}}"
      desc="{{guest ? '当前会话尚未通过服务端核实，请前往登录页。' : '本页不展示收藏与历史明细：请用上方“我的收藏”和“识别历史”进入对应页面。那两个页面完全由服务端读取，失败时如实报错，不会用本地数据顶替。'}}"
      action-text="{{guest ? '去登录' : ''}}"
      bind:action="onLogin"
    ></state-view>
  </view>
</view>
