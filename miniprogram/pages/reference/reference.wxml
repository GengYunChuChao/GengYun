<view class="page" style="--font-scale: {{fontScale}}">
  <view class="title">识草查药 · 科普资料查询</view>

  <!-- 替身边界说明 + **可判定数据来源标记**：服务端 /herbicides 读数与随包离线副本必须能区分。 -->
  <view class="banner">{{modeNote}}</view>
  <view class="catalog-version source-line" wx:if="{{dataSourceLabel}}">{{dataSourceLabel}}</view>
  <!-- 失败态统一走 state-view（不把失败写成一行灰字，也不与下面的空态混在一起）：
       503／超时等可重试失败给「重试查询」，401 会话失效给「核实登录后重试」；
       错误码原样交给组件补分类标签与可重试性，页面自己的领域文案仍然优先。 -->
  <state-view
    wx:if="{{queryError}}"
    status="{{querySession ? 'guest' : 'error'}}"
    error-code="{{queryErrorCode}}"
    title="{{querySession ? '登录状态已变化，本次查询没有执行' : '这次查询没有完成'}}"
    desc="{{queryError}}"
    action-text="{{querySession ? '核实登录后重试' : '重试查询'}}"
    bind:action="onRetry"
  ></state-view>
  <view class="catalog-version">目录版本：{{catalogVersion}}</view>

  <!-- 导航：作物 → 杂草 → 地区（除草方式由关键词/结构化条件表达） -->
  <view class="card">
    <view class="nav-row">
      <text class="nav-label">作物</text>
      <picker bindchange="onCrop" value="{{cropIndex}}" range="{{crops}}" range-key="name">
        <view class="picker-value">{{cropIndex >= 0 ? crops[cropIndex].name : '全部作物'}}</view>
      </picker>
    </view>
    <view class="nav-row">
      <text class="nav-label">杂草</text>
      <picker bindchange="onSpecies" value="{{speciesIndex}}" range="{{species}}" range-key="group_name">
        <view class="picker-value">{{speciesIndex >= 0 ? species[speciesIndex].group_name : '全部杂草'}}</view>
      </picker>
    </view>
    <view class="nav-row">
      <text class="nav-label">地区</text>
      <picker bindchange="onRegion" value="{{regionIndex}}" range="{{regions}}" range-key="name">
        <view class="picker-value">{{regionIndex >= 0 ? regions[regionIndex].name : '全部地区'}}</view>
      </picker>
    </view>
    <!-- 剂型：只按登记剂型收窄，**不提供含量换算、不提供用量**（本页不生成用药方案）。 -->
    <view class="nav-row">
      <text class="nav-label">剂型</text>
      <picker bindchange="onDosageForm" value="{{formIndex}}" range="{{dosageForms}}">
        <view class="picker-value">{{formIndex >= 0 ? dosageForms[formIndex] : '全部剂型'}}</view>
      </picker>
    </view>
    <view class="nav-row">
      <text class="nav-label">关键词</text>
      <input class="keyword-input" value="{{keyword}}" placeholder="药名／登记证号／成分" bindinput="onKeyword" bindconfirm="onSearch" />
    </view>
    <view class="actions">
      <button class="btn btn-primary" bindtap="onSearch">查询</button>
      <button class="btn btn-ghost" bindtap="onReset">重置</button>
    </view>
  </view>

  <!-- 加载态：首屏／换条件后的请求在途时渲染「正在查询」。
       **不得**落到下面的空态文案「没有可展示的资料」——加载中被说成没有资料，
       用户会以为条件筛空了而去改条件，实际只是还没返回。 -->
  <state-view
    wx:if="{{busy && !items.length}}"
    status="loading"
    title="正在向服务端查询登记资料"
    desc="查询返回前不展示任何记录，也不把「查询中」写成「没有资料」。"
  ></state-view>

  <!-- 结果状态（无结果/条件不足均如实展示，不用空白填充） -->
  <view class="state-bar state-{{matchState}}">{{matchLabel}}</view>
  <view class="reasons" wx:if="{{reasons.length}}">
    <view wx:for="{{reasons}}" wx:key="*this" class="reason">· {{item}}</view>
  </view>
  <view class="reasons" wx:if="{{simulatedExcluded}}">
    <view class="reason">· 已排除 {{simulatedExcluded}} 条模拟演示记录（非真实资料，不计入查询结果）</view>
  </view>
  <view class="result-count" wx:if="{{countNote}}">{{countNote}}</view>
  <!-- 命中条件（可解释字段）：命中的每条记录都满足这些条件，条件未被放宽。 -->
  <view class="catalog-version" wx:if="{{matchedNote}}">{{matchedNote}}</view>

  <!-- 列表：每条展示同一 source_version 与同一数据来源标记；不合并不同含量的剂型 -->
  <view class="card item" wx:for="{{items}}" wx:key="record_id" bindtap="goDetail" data-id="{{item.record_id}}" data-source="{{item.data_source}}">
    <view class="item-head">
      <text class="item-name">{{item.registered_name || item.registration_number}}</text>
      <text class="item-reg" wx:if="{{item.registered_name}}">{{item.registration_number}}</text>
    </view>
    <view class="item-line" wx:if="{{item.dosage_form || item.toxicity}}">剂型：{{item.dosage_form || '接口未提供'}} · 毒性：{{item.toxicity || '接口未提供'}}</view>
    <view class="item-line">有效成分：{{item.ingredients_text}}</view>
    <view class="item-line" wx:if="{{item.use_scene}}">作物／场所：{{item.use_scene}}</view>
    <view class="item-line" wx:if="{{item.risk_text}}">{{item.risk_text}}</view>
    <view class="tags">
      <text class="tag">{{item.labels.source_kind}}</text>
      <text class="tag">{{item.labels.review_status}}</text>
      <text class="tag tag-warn">{{item.labels.record_status}}</text>
      <text class="tag tag-source" wx:if="{{item.source_marker}}">{{item.source_marker}}</text>
    </view>
    <!-- 来源可追溯：名称（发布机构 · 来源标题）／登记标识／版本。缺项显示可解释占位，
         不用空白或由页面补写的名称填充（服务端行取 SourceRef，随包行取登记表）。 -->
    <view class="item-src">来源：{{item.source_name || '接口未提供'}}</view>
    <view class="item-src">来源标识：{{item.source_id || '接口未提供'}}</view>
    <view class="item-src">来源版本：{{item.source_version || '接口未提供'}}</view>
  </view>

  <!-- 空内容态（无命中，且**不是**加载中、也不是失败）：给出「下一步做什么」，
       失败不落到这里，避免把「请求没完成」渲染成「没有资料」。 -->
  <view class="empty" wx:if="{{!items.length && !busy && !queryError && matchState !== 'invalid'}}">
    没有可展示的资料。可调整作物／杂草／地区或更换关键词继续查询。
  </view>

  <button wx:if="{{nextCursor}}" class="btn btn-ghost" bindtap="onLoadMore">加载更多</button>

  <view class="disclaimer">
    本页不提供用药量建议；资料为登记信息摘录，未逐字段复核标签原文，不得作为用药依据。
  </view>
</view>
