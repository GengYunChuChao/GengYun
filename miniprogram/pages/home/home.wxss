/* 首页（GY-I26 demo 对齐）
 * ---------------------------------------------------------------------------
 * 通用形态（hero 的排版／feature-card／info-row／panel／section）已落到
 * styles/components.wxss，本文件只保留首页专属的少量覆盖，避免与样式层重复定义。
 * 对照关系见 docs/verification/gy-i26-demo-align-20261014.md。
 */

/* demo .hero 里没有「游客」标记；小程序需要显式说明游客范围，沿用 hero 的浅绿字色。
   高度随字体放大（min-height），并保留上下内边距，换行时不溢出圆角框。 */
.hero__badge {
  display: inline-flex;
  align-items: center;
  min-height: calc(26px * var(--font-scale, 1));
  margin-top: 24rpx;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  font-size: calc(16px * var(--font-scale, 1));
  font-weight: 600;
  color: var(--lime);
  border: 1px solid rgba(198, 241, 123, 0.45);
}

/* 首页 Hero 的装饰在右侧，但正文不能因此被压缩到 77%：普通视口下
   eyebrow 的末字会孤行。只在本页放开内容宽度，不改其他页的 Hero。 */
.hero__content {
  width: 100%;
}

.hero__eyebrow {
  line-height: 1.5;
}

/* 英文口号属于文档流内容。绝对定位会在游客标记增高后与主按钮重叠，
   改为正常流并由 margin 建立间距，字号或文案变化时也能自然撑高。 */
.hero__code {
  position: static;
  margin-top: 16px;
  line-height: 1.5;
}

.home-login {
  margin-top: 17px;
}

/* demo .new-tag 的位置；文案是「未接入」而不是 demo 的 NEW，语气按替身边界要求 */
.feature-card__stub {
  position: absolute;
  top: 12px;
  right: 13px;
}

.preview-panel {
  padding-top: 16px;
}

.preview-note,
.preview-human-review {
  font-size: calc(14px * var(--font-scale, 1));
  color: var(--muted);
  line-height: 1.7;
}

.preview-note {
  margin-bottom: 8px;
}

.preview-source {
  display: block;
  margin-top: 6px;
  font-size: calc(14px * var(--font-scale, 1));
  color: var(--color-text-sub, #52675e);
  line-height: 1.6;
}

.preview-human-review {
  margin-top: 12px;
}

.dev-status {
  margin-top: 16px;
  font-size: calc(16px * var(--font-scale, 1));
  color: var(--color-text-muted, #7b8983);
  line-height: 1.7;
}
