.hero {
  padding: 40rpx 32rpx 36rpx;
  margin-bottom: 8rpx;
  border-radius: var(--radius-lg, 28rpx);
  background: linear-gradient(160deg, #2A9159 0%, #1F7A45 60%, #145C34 100%);
  color: #FFFFFF;
}

.hero__brand {
  font-size: 16px;
  letter-spacing: 4rpx;
  opacity: 0.9;
}

.hero__title {
  margin-top: 12rpx;
  font-size: 28px;
  font-weight: 700;
  line-height: 1.3;
}

.hero__sub {
  margin-top: 12rpx;
  font-size: 16px;
  opacity: 0.92;
}

.hero__badge {
  display: inline-flex;
  align-items: center;
  min-height: 26px;
  margin-top: 24rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 16px;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.45);
}

.entry {
  display: flex;
  align-items: center;
  min-height: var(--tap-min, 44px);
  padding: 24rpx 24rpx;
  margin-bottom: 20rpx;
  border-radius: var(--radius-lg, 28rpx);
  background: var(--color-surface, #fff);
  border: 2rpx solid var(--color-border, #D8E4DC);
  transition: transform 0.16s ease;
}

.entry--hover {
  transform: scale(0.985);
}

.entry__icon {
  flex: 0 0 auto;
  width: 96rpx;
  height: 96rpx;
  margin-right: 24rpx;
  border-radius: 24rpx;
  background: var(--color-primary-soft, #E8F3EC);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
}

.entry__body {
  flex: 1;
  min-width: 0;
}

.entry__title {
  font-size: 18px;
  font-weight: 600;
}

.entry__desc {
  margin-top: 6rpx;
  font-size: 16px;
  color: var(--color-text-sub, #4A5A4E);
}

.entry .badge {
  flex: 0 0 auto;
  margin-left: 16rpx;
}

.dev-btn {
  width: 100%;
}

.dev-status {
  margin-top: 16rpx;
  font-size: 16px;
  color: var(--color-text-muted, #6F7F72);
  line-height: 1.6;
}
