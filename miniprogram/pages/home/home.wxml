<view class="page" style="--font-scale: {{fontScale}}">
  <view class="hero">
    <view class="hero__brand">耕云</view>
    <view class="hero__title">识草查药，除草不求人</view>
    <view class="hero__sub">识草查药与除草科普社区</view>
    <view class="hero__badge" wx:if="{{guest}}">游客仅可预览首页</view>
  </view>
  <button wx:if="{{guest}}" class="btn btn--primary" bindtap="goLogin">微信登录</button>

  <view class="section-title">常用功能</view>

  <view
    class="entry"
    wx:for="{{entries}}"
    wx:key="key"
    hover-class="entry--hover"
    bindtap="onEntryTap"
  >
    <view class="entry__icon">{{item.icon}}</view>
    <view class="entry__body">
      <view class="entry__title">{{item.title}}</view>
      <view class="entry__desc">{{item.desc}}</view>
    </view>
    <view class="badge badge--stub">未接入</view>
  </view>

  <view class="section-title">当前状态</view>
  <state-view
    status="stub"
    title="功能尚未接入"
    desc="拍草识别、标签识别、语音提问与社区均未接入真实服务。本页仅用于界面与导航走查，所列内容不能作为用药依据。"
  ></state-view>

  <block wx:if="{{local}}">
    <view class="section-title">开发工具</view>
    <button
      class="btn btn--ghost dev-btn"
      bindtap="diagnose"
      loading="{{busy}}"
      disabled="{{busy}}"
    >检查本地替身连接</button>
    <view class="dev-status">{{status}}</view>
  </block>
</view>
