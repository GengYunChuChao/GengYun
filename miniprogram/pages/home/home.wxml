<view class="page" style="--font-scale: {{fontScale}}">
  <view class="page-heading">
    <view class="page-heading__main">
      <view class="page-heading__title">早安，田间探索者</view>
      <view class="page-heading__sub">从一次观察开始，发现更多田间可能。</view>
    </view>
  </view>

  <view class="hero">
    <view class="hero__art"></view>
    <view class="hero__content">
      <view class="hero__eyebrow"><view class="dot"></view>FIELD INTELLIGENCE / 耕云</view>
      <view class="hero__title">识草查药，除草不求人</view>
      <view class="hero__sub">识草查药与除草科普社区</view>
      <view class="hero__badge" wx:if="{{guest}}">游客仅可预览首页</view>
      <button class="btn btn--lime hero__action" bindtap="onEntryTap">开始识别</button>
    </view>
    <view class="hero__code">OBSERVE · UNDERSTAND · EXPLORE</view>
  </view>

  <button wx:if="{{guest}}" class="btn btn--primary btn--block home-login" bindtap="goLogin">微信登录</button>

  <view class="section">
    <view class="section-head">
      <view class="section-head__title">你的田间工具</view>
      <view class="section-head__meta">三个入口，一个探索旅程</view>
    </view>
    <view class="feature-grid">
      <button
        wx:for="{{entries}}"
        wx:key="key"
        class="feature-card"
        hover-class="feature-card--hover"
        data-key="{{item.key}}"
        bindtap="onEntryTap"
      >
        <view class="feature-card__icon"><view class="gy-icon {{item.iconClass}}"></view></view>
        <view class="feature-card__title">{{item.title}}</view>
        <view class="feature-card__desc">{{item.desc}}</view>
        <view class="badge badge--stub feature-card__stub">{{item.badge}}</view>
      </button>
    </view>
  </view>

  <view class="section home-preview">
    <view class="section-head">
      <view class="section-head__title">公开预览</view>
      <view class="section-head__meta">无需登录 · 仅标题与摘要</view>
    </view>
    <state-view
      wx:if="{{previewStatus === 'loading'}}"
      status="loading"
      title="正在读取公开预览"
      desc="只读取公开标题与摘要，不要求登录。"
    ></state-view>
    <state-view
      wx:elif="{{previewStatus === 'error'}}"
      status="error"
      title="公开预览读取失败"
      desc="{{previewMessage}}"
      error-code="{{previewErrorCode}}"
      action-text="重试公开预览"
      bind:action="retryPreviews"
    ></state-view>
    <state-view
      wx:elif="{{previewStatus === 'empty'}}"
      status="empty"
      title="暂时没有公开预览"
      desc="服务端返回了合法空列表；没有使用本地内容填充。"
    ></state-view>
    <state-view
      wx:elif="{{previewStatus === 'disabled'}}"
      status="stub"
      title="公开预览未启用"
      desc="{{previewMessage}}"
    ></state-view>
    <view wx:elif="{{previewStatus === 'ready'}}" class="panel preview-panel">
      <view class="preview-note">{{previewNote}}</view>
      <view class="info-list">
        <button
          wx:for="{{previewItems}}"
          wx:key="id"
          class="info-row preview-row"
          style="width:100%;margin:0;text-align:left;"
          data-kind="{{item.kind}}"
          bindtap="onPreviewTap"
        >
          <view class="info-row__copy">
            <text class="info-row__title">{{item.title}}</text>
            <text class="info-row__desc">{{item.summary}}</text>
            <text class="preview-source">{{item.typeLabel}} · {{item.sourceLabel}}</text>
          </view>
          <view class="gy-icon gy-icon--arrow"></view>
        </button>
      </view>
    </view>
    <view class="preview-human-review">人工审核入口建设中，暂不开放人工审核服务。</view>
  </view>

  <view class="home-bottom">
    <view class="panel">
      <view class="panel-head">
        <view class="panel-head__title">田间知识，一点点积累</view>
        <!-- demo .home-bottom 第一个 panel 的 panel-head 里是 link('查看资料库 →','library')，
             即 <button class="text-btn" data-route="library">。这里落到既有路由 pages/knowledge/knowledge，
             与下方「科普知识」info-row 共用 goKnowledge 的门禁跳转（不新增页面、不新增接口）。 -->
        <button class="text-btn" bindtap="goKnowledge">
          查看资料库
          <view class="gy-icon gy-icon--arrow"></view>
        </button>
      </view>
      <view class="info-list">
        <button class="info-row" bindtap="goKnowledge">
          <view class="tiny-art"><view class="gy-icon gy-icon--leaf"></view></view>
          <view class="info-row__copy">
            <text class="info-row__title">科普知识（服务端查询）</text>
            <text class="info-row__desc">检索资料，核对来源与适用条件</text>
          </view>
          <view class="gy-icon gy-icon--arrow"></view>
        </button>
        <button class="info-row" bindtap="goReference">
          <view class="tiny-art"><view class="gy-icon gy-icon--leaf"></view></view>
          <view class="info-row__copy">
            <text class="info-row__title">识草查药（本地静态资料）</text>
            <text class="info-row__desc">按作物与地区查阅已整理的资料条目</text>
          </view>
          <view class="gy-icon gy-icon--arrow"></view>
        </button>
        <button class="info-row" bindtap="goReferenceSeed">
          <view class="tiny-art"><view class="gy-icon gy-icon--leaf"></view></view>
          <view class="info-row__copy">
            <text class="info-row__title">科普种子资料库</text>
            <text class="info-row__desc">本地 · 待核实 · 非权威，仅供内部走查</text>
          </view>
          <view class="gy-icon gy-icon--arrow"></view>
        </button>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-head__title">当前状态</view>
    </view>
    <state-view
      status="stub"
      title="演示与走查状态"
      desc="拍草识别、标签识别、语音合成播报与社区已接服务端（录音转写尚未接线）；真实提供者、真实数据与真机验收未完成，本页所列内容不能作为用药依据。"
    ></state-view>
  </view>

  <view class="section" wx:if="{{local}}">
    <view class="section-head">
      <view class="section-head__title">开发工具</view>
    </view>
    <view class="panel">
      <button
        class="btn btn--ghost btn--block"
        bindtap="diagnose"
        loading="{{busy}}"
        disabled="{{busy}}"
      >检查本地替身连接</button>
      <button class="btn btn--ghost btn--block" bindtap="goSpecimen">样式走查（demo 对齐核对）</button>
      <!-- 处理中与失败都收口到统一 state-view（B7）：诊断失败不再和成功说明混成同一行灰字。
           失败原因由 utils/debug.js 如实回传，本页不改写、不吞。 -->
      <state-view
        wx:if="{{busy}}"
        status="loading"
        title="正在检查本地替身连接"
        desc="正在读取本地诊断服务状态，请稍候。"
      ></state-view>
      <state-view
        wx:elif="{{diagPassed === false}}"
        status="error"
        title="本地诊断没有通过"
        desc="{{status}}"
      ></state-view>
      <view class="dev-status" wx:else>{{status}}</view>
    </view>
  </view>
</view>
