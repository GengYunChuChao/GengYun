<view class="page" style="--font-scale: {{fontScale}}">
  <view class="page-heading">
    <view class="page-heading__main">
      <view class="page-heading__title">田间的发现，值得分享</view>
      <view class="page-heading__sub">记录日常观察，和更多耕耘者一起交流。每条内容先经审核，通过后才对他人可见。</view>
    </view>
  </view>

  <!-- demo communitySwitch：社区 ⇄ 资料库。资料库复用既有知识页，不新建页面。 -->
  <view class="tabs community-switch">
    <view class="tabs__item tabs__item--active" aria-current="page">社区</view>
    <button class="tabs__item" bindtap="onOpenLibrary">资料库</button>
  </view>

  <state-view
    wx:if="{{guest}}"
    status="guest"
    title="请先登录"
    desc="社区内容需要登录后查看；登录仅用于保存你的记录，不会公开你的位置。"
    action-text="去登录"
    bind:action="onLogin"
  ></state-view>

  <block wx:else>
    <view class="section-head">
      <view class="section-head__title">田间动态</view>
      <gy-ui-button label="分享发现" variant="primary" bind:tap="onCreate"></gy-ui-button>
    </view>

    <view class="chips">
      <gy-ui-chip label="全部" value="all" selected="{{!filterMine}}" bind:select="onToggleMine"></gy-ui-chip>
      <gy-ui-chip label="我的投稿" value="mine" selected="{{filterMine}}" bind:select="onToggleMine"></gy-ui-chip>
    </view>

    <view class="chips">
      <picker range="{{cropLabels}}" value="{{cropIndex}}" bindchange="onCropChange">
        <view class="chip">作物：{{cropLabels[cropIndex]}}</view>
      </picker>
      <picker range="{{regionLabels}}" value="{{regionIndex}}" bindchange="onRegionChange">
        <view class="chip">地区：{{regionLabels[regionIndex]}}</view>
      </picker>
    </view>

    <state-view wx:if="{{status === 'loading'}}" status="loading"></state-view>

    <state-view
      wx:elif="{{status === 'error'}}"
      status="error"
      title="社区内容没有取到"
      desc="{{errorText}}"
    ></state-view>

    <state-view
      wx:elif="{{status === 'empty'}}"
      status="empty"
      title="还没有符合条件的内容"
      desc="换个作物或地区条件再试，也可以先分享一条田间发现。"
      action-text="分享发现"
      bind:action="onCreate"
    ></state-view>

    <block wx:else>
      <view class="feed">
        <view class="post" wx:for="{{posts}}" wx:key="id">
          <view class="post-author">
            <view class="post-author__copy">
              <view class="post-author__title">{{item.author}}</view>
              <view class="post-author__meta">{{item.time}}{{item.crop_id ? ' · ' + item.crop_id : ''}}{{item.region_code ? ' · ' + item.region_code : ''}}</view>
            </view>
            <view wx:if="{{item.stateLabel}}" class="post-author__tag pill pill--amber">{{item.stateLabel}}</view>
          </view>
          <view class="post-title">{{item.title}}</view>
          <view class="post-text">{{item.body}}</view>
          <view wx:if="{{item.linkTitle}}" class="pill">关联资料：{{item.linkTitle}}</view>
          <view class="post-actions">
            <button class="post-actions__item" data-id="{{item.id}}" bindtap="onOpenPost">查看与评论</button>
          </view>
        </view>
      </view>

      <view class="row-actions">
        <gy-ui-button
          wx:if="{{nextCursor}}"
          label="{{loadingMore ? '正在加载…' : '加载更多'}}"
          variant="ghost"
          loading="{{loadingMore}}"
          bind:tap="onLoadMore"
        ></gy-ui-button>
        <view wx:else class="demo-caption">已经到底了。</view>
      </view>

      <view class="demo-caption">{{modeNote}}</view>
    </block>
  </block>
</view>
