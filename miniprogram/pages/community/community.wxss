.notice {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 28rpx;
  border-radius: var(--radius, 20rpx);
  background: #FFF6E5;
  border: 2rpx solid #F0D9A8;
}

.notice__icon {
  font-size: 16px;
  margin-right: 14rpx;
  line-height: 1.5;
}

.notice__text {
  flex: 1;
  font-size: 16px;
  line-height: 1.6;
  color: #7A5A16;
}
