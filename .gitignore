# Local Word documents and document folder
*.doc
*.docx
*.docm
/doc/

# Microsoft Office temporary files
~$*

# Local secrets (keep sanitized examples trackable)
.env
.env.*
!.env.example
!.env.sample

# Dependencies, caches, and generated output
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/
coverage/
*.log

# Local editor and operating system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Local supervisor cache and publishing helpers (never credentials in repo)
/.supervisor/

# WeChat developer tools personal settings
project.private.config.json
!project.private.config.json.example

# GY-I25 server-side local verification configuration
/docs/verification/config.local.json
# Isolated local-debug projects and private configuration
/.local/
/config/*.local.json
!/config/*.local.json.example

# Online-purge cross-run cursor: machine-local progress state, never committed
/.gengyun-online-purge-cursor.json
/.gengyun-online-purge-cursor.json.tmp-*
